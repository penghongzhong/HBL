import HBL.AffineTailLogIntegralEvaluation
import HBL.AffineTailHartreePairing
import Mathlib.Analysis.Convolution
import Mathlib.Analysis.SpecialFunctions.Integrability.Basic
import Mathlib.Analysis.SpecialFunctions.ImproperIntegrals
import Mathlib.Analysis.SpecialFunctions.Pow.Real

/-!
Absolute integrability of the genuine real-channel Hartree commutator
density.  The logarithmic diagonal is controlled by an integrable
`|r-rho|^(-1/2)` kernel, while the complementary region is bounded by
separable one-dimensional tails.
-/

noncomputable section

open Set MeasureTheory

namespace HBL.Modulation.AffineTail

/-- Absolute radial factor supplied by the scaling resonance. -/
def scaleHartreeWeight (r : ℝ) : ℝ :=
  |resonancePlus r * bubble r ^ 3|

/-- The preceding weight with the square-root factor generated by the
diagonal logarithm estimate. -/
def scaleHartreeSqrtWeight (r : ℝ) : ℝ :=
  Real.sqrt r * scaleHartreeWeight r

/-- Absolute radial factor supplied by the affine cutoff. -/
def affineHartreeWeight (rho : ℝ) : ℝ :=
  |bubble rho ^ 3 * model rho|

/-- The affine weight with the square-root factor generated by the
diagonal logarithm estimate. -/
def affineHartreeSqrtWeight (rho : ℝ) : ℝ :=
  Real.sqrt rho * affineHartreeWeight rho

/-- Compactly supported model of the locally integrable diagonal
singularity. -/
def diagonalSqrtKernel (x : ℝ) : ℝ :=
  if |x| < 1 then (Real.sqrt |x|)⁻¹ else 0

theorem scaleHartreeWeight_nonneg (r : ℝ) :
    0 ≤ scaleHartreeWeight r := abs_nonneg _

theorem scaleHartreeSqrtWeight_nonneg (r : ℝ) :
    0 ≤ scaleHartreeSqrtWeight r :=
  mul_nonneg (Real.sqrt_nonneg _) (scaleHartreeWeight_nonneg r)

theorem affineHartreeWeight_nonneg (rho : ℝ) :
    0 ≤ affineHartreeWeight rho := abs_nonneg _

theorem affineHartreeSqrtWeight_nonneg (rho : ℝ) :
    0 ≤ affineHartreeSqrtWeight rho :=
  mul_nonneg (Real.sqrt_nonneg _) (affineHartreeWeight_nonneg rho)

theorem scaleHartreeWeight_closed (r : ℝ) :
    scaleHartreeWeight r =
      |r * (1 - r ^ 2)| / (2 * (1 + r ^ 2) ^ 3) := by
  unfold scaleHartreeWeight
  rw [mul_comm, bubble_cube_mul_scale_eq_rational, abs_div,
    abs_of_pos (by positivity : 0 < 2 * (1 + r ^ 2) ^ 3)]

theorem scaleHartreeWeight_le (r : ℝ) :
    scaleHartreeWeight r ≤ (1 + r ^ 2)⁻¹ / 2 := by
  rw [scaleHartreeWeight_closed]
  have hden : 0 < 1 + r ^ 2 := by positivity
  have hr : |r| ≤ 1 + r ^ 2 := by
    nlinarith [sq_nonneg (|r| - 1), sq_abs r]
  have hdiff : |1 - r ^ 2| ≤ 1 + r ^ 2 := by
    rw [abs_le]
    constructor <;> nlinarith [sq_nonneg r]
  rw [abs_mul]
  have hmul : |r| * |1 - r ^ 2| ≤ (1 + r ^ 2) ^ 2 := by
    nlinarith [abs_nonneg r, abs_nonneg (1 - r ^ 2)]
  rw [div_le_iff₀ (by positivity : 0 < 2 * (1 + r ^ 2) ^ 3)]
  field_simp
  nlinarith

theorem scaleHartreeSqrtWeight_le (r : ℝ) :
    scaleHartreeSqrtWeight r ≤ (1 + r ^ 2)⁻¹ / 2 := by
  by_cases hr : 0 ≤ r
  · have hs2 : Real.sqrt r ^ 2 = r := Real.sq_sqrt hr
    have hrs : r * Real.sqrt r ≤ 1 + r ^ 2 := by
      by_cases h1 : r ≤ 1
      · have hsle : Real.sqrt r ≤ 1 := by
          nlinarith [Real.sqrt_nonneg r]
        nlinarith [Real.sqrt_nonneg r]
      · have hsle : Real.sqrt r ≤ r := by
          nlinarith [Real.sqrt_nonneg r]
        nlinarith [Real.sqrt_nonneg r]
    rw [scaleHartreeSqrtWeight, scaleHartreeWeight_closed, abs_mul,
      abs_of_nonneg hr]
    have hdiff : |1 - r ^ 2| ≤ 1 + r ^ 2 := by
      rw [abs_le]
      constructor <;> nlinarith [sq_nonneg r]
    have hmul : Real.sqrt r * (r * |1 - r ^ 2|) ≤
        (1 + r ^ 2) ^ 2 := by
      nlinarith [Real.sqrt_nonneg r, abs_nonneg (1 - r ^ 2)]
    rw [show Real.sqrt r *
          (r * |1 - r ^ 2| / (2 * (1 + r ^ 2) ^ 3)) =
        (Real.sqrt r * (r * |1 - r ^ 2|)) /
          (2 * (1 + r ^ 2) ^ 3) by ring]
    rw [show (1 + r ^ 2)⁻¹ / 2 =
        (1 + r ^ 2) ^ 2 / (2 * (1 + r ^ 2) ^ 3) by
          field_simp]
    exact (div_le_div_iff_of_pos_right
      (by positivity : 0 < 2 * (1 + r ^ 2) ^ 3)).2 hmul
  · have hs : Real.sqrt r = 0 := Real.sqrt_eq_zero_of_nonpos (le_of_not_ge hr)
    rw [scaleHartreeSqrtWeight, hs, zero_mul]
    positivity

theorem scaleHartreeWeight_aestronglyMeasurable :
    AEStronglyMeasurable scaleHartreeWeight := by
  have hc : Continuous (fun r : ℝ =>
      |r * (1 - r ^ 2)| / (2 * (1 + r ^ 2) ^ 3)) := by
    fun_prop (discharger := intro; positivity)
  apply hc.aestronglyMeasurable.congr
  filter_upwards with r
  exact (scaleHartreeWeight_closed r).symm

theorem scaleHartreeWeight_continuous :
    Continuous scaleHartreeWeight := by
  have hc : Continuous (fun r : ℝ =>
      |r * (1 - r ^ 2)| / (2 * (1 + r ^ 2) ^ 3)) := by
    fun_prop (discharger := intro; positivity)
  exact hc.congr (fun r => (scaleHartreeWeight_closed r).symm)

theorem scaleHartreeSqrtWeight_continuous :
    Continuous scaleHartreeSqrtWeight := by
  unfold scaleHartreeSqrtWeight
  exact Real.continuous_sqrt.mul scaleHartreeWeight_continuous

theorem scaleHartreeSqrtWeight_aestronglyMeasurable :
    AEStronglyMeasurable scaleHartreeSqrtWeight := by
  unfold scaleHartreeSqrtWeight
  exact Real.continuous_sqrt.aestronglyMeasurable.mul
    scaleHartreeWeight_aestronglyMeasurable

theorem scaleHartreeWeight_integrable :
    Integrable scaleHartreeWeight := by
  have hmajor : Integrable (fun r : ℝ => (1 + r ^ 2)⁻¹ / 2) := by
    simpa [div_eq_mul_inv] using
      (integrable_inv_one_add_sq.mul_const (2 : ℝ)⁻¹)
  refine hmajor.mono' scaleHartreeWeight_aestronglyMeasurable ?_
  filter_upwards with r
  rw [Real.norm_eq_abs, abs_of_nonneg (scaleHartreeWeight_nonneg r)]
  exact scaleHartreeWeight_le r

theorem scaleHartreeSqrtWeight_integrable :
    Integrable scaleHartreeSqrtWeight := by
  have hmajor : Integrable (fun r : ℝ => (1 + r ^ 2)⁻¹ / 2) := by
    simpa [div_eq_mul_inv] using
      (integrable_inv_one_add_sq.mul_const (2 : ℝ)⁻¹)
  refine hmajor.mono' scaleHartreeSqrtWeight_aestronglyMeasurable ?_
  filter_upwards with r
  rw [Real.norm_eq_abs, abs_of_nonneg (scaleHartreeSqrtWeight_nonneg r)]
  exact scaleHartreeSqrtWeight_le r

theorem scaleHartreeWeight_le_one (r : ℝ) :
    ‖scaleHartreeWeight r‖ ≤ 1 := by
  rw [Real.norm_eq_abs, abs_of_nonneg (scaleHartreeWeight_nonneg r)]
  calc
    scaleHartreeWeight r ≤ (1 + r ^ 2)⁻¹ / 2 := scaleHartreeWeight_le r
    _ ≤ 1 := by
      have hden : 1 ≤ 1 + r ^ 2 := by nlinarith [sq_nonneg r]
      have hi : (1 + r ^ 2)⁻¹ ≤ 1 :=
        (inv_le_one₀ (by positivity : 0 < 1 + r ^ 2)).2 hden
      linarith

theorem scaleHartreeSqrtWeight_le_one (r : ℝ) :
    ‖scaleHartreeSqrtWeight r‖ ≤ 1 := by
  rw [Real.norm_eq_abs, abs_of_nonneg (scaleHartreeSqrtWeight_nonneg r)]
  calc
    scaleHartreeSqrtWeight r ≤ (1 + r ^ 2)⁻¹ / 2 :=
      scaleHartreeSqrtWeight_le r
    _ ≤ 1 := by
      have hden : 1 ≤ 1 + r ^ 2 := by nlinarith [sq_nonneg r]
      have hi : (1 + r ^ 2)⁻¹ ≤ 1 :=
        (inv_le_one₀ (by positivity : 0 < 1 + r ^ 2)).2 hden
      linarith

theorem affineHartreeWeight_aestronglyMeasurable :
    AEStronglyMeasurable affineHartreeWeight := by
  unfold affineHartreeWeight
  exact ((bubble_contDiff_infty.continuous.pow 3).mul
    model_contDiff_infty.continuous).abs.aestronglyMeasurable

theorem affineHartreeWeight_continuous :
    Continuous affineHartreeWeight := by
  unfold affineHartreeWeight
  exact ((bubble_contDiff_infty.continuous.pow 3).mul
    model_contDiff_infty.continuous).abs

theorem affineHartreeSqrtWeight_continuous :
    Continuous affineHartreeSqrtWeight := by
  unfold affineHartreeSqrtWeight
  exact Real.continuous_sqrt.mul affineHartreeWeight_continuous

theorem affineHartreeSqrtWeight_aestronglyMeasurable :
    AEStronglyMeasurable affineHartreeSqrtWeight := by
  unfold affineHartreeSqrtWeight
  exact Real.continuous_sqrt.aestronglyMeasurable.mul
    affineHartreeWeight_aestronglyMeasurable

theorem affineHartreeWeight_zero_of_le_one (rho : ℝ) (hrho : rho ≤ 1) :
    affineHartreeWeight rho = 0 := by
  simp [affineHartreeWeight, model_zero_of_le_one rho hrho]

theorem affineHartreeSqrtWeight_zero_of_le_one (rho : ℝ) (hrho : rho ≤ 1) :
    affineHartreeSqrtWeight rho = 0 := by
  simp [affineHartreeSqrtWeight,
    affineHartreeWeight_zero_of_le_one rho hrho]

theorem affineHartreeWeight_closed_of_one_lt
    (rho : ℝ) (hrho : 1 < rho) :
    affineHartreeWeight rho =
      cutoff rho * rho / Real.sqrt (1 + rho ^ 2) ^ 3 := by
  have hc0 : 0 ≤ cutoff rho := Real.smoothTransition.nonneg _
  have hr0 : 0 ≤ rho := le_trans (by norm_num) hrho.le
  have hs0 : Real.sqrt (1 + rho ^ 2) ≠ 0 := by positivity
  unfold affineHartreeWeight model bubble
  rw [abs_of_nonneg]
  · field_simp [hs0]
  · positivity

theorem affineHartreeWeight_le_rpow
    (rho : ℝ) (hrho : 1 < rho) :
    affineHartreeWeight rho ≤ rho ^ (-(2 : ℝ)) := by
  rw [affineHartreeWeight_closed_of_one_lt rho hrho]
  have hrpos : 0 < rho := lt_trans zero_lt_one hrho
  have hspos : 0 < Real.sqrt (1 + rho ^ 2) := by positivity
  have hsge : rho ≤ Real.sqrt (1 + rho ^ 2) := by
    have h := Real.sqrt_le_sqrt (show rho ^ 2 ≤ 1 + rho ^ 2 by linarith)
    rwa [Real.sqrt_sq_eq_abs, abs_of_pos hrpos] at h
  have hs3 : rho ^ 3 ≤ Real.sqrt (1 + rho ^ 2) ^ 3 :=
    pow_le_pow_left₀ hrpos.le hsge 3
  have hcut : cutoff rho ≤ 1 := Real.smoothTransition.le_one _
  calc
    cutoff rho * rho / Real.sqrt (1 + rho ^ 2) ^ 3 ≤
        rho / Real.sqrt (1 + rho ^ 2) ^ 3 := by
      apply div_le_div_of_nonneg_right
      · nlinarith [Real.smoothTransition.nonneg (rho - 1)]
      · positivity
    _ ≤ rho / rho ^ 3 :=
      div_le_div_of_nonneg_left hrpos.le (pow_pos hrpos 3) hs3
    _ = rho ^ (-(2 : ℝ)) := by
      calc
        rho / rho ^ 3 = rho ^ (1 : ℝ) / rho ^ (3 : ℝ) := by
          norm_num [Real.rpow_one, Real.rpow_natCast]
        _ = rho ^ ((1 : ℝ) - 3) := by rw [Real.rpow_sub hrpos]
        _ = rho ^ (-(2 : ℝ)) := by norm_num

theorem affineHartreeSqrtWeight_le_rpow
    (rho : ℝ) (hrho : 1 < rho) :
    affineHartreeSqrtWeight rho ≤ rho ^ (-(3 / 2 : ℝ)) := by
  rw [affineHartreeSqrtWeight,
    affineHartreeWeight_closed_of_one_lt rho hrho]
  have hrpos : 0 < rho := lt_trans zero_lt_one hrho
  have hspos : 0 < Real.sqrt (1 + rho ^ 2) := by positivity
  have hsge : rho ≤ Real.sqrt (1 + rho ^ 2) := by
    have h := Real.sqrt_le_sqrt (show rho ^ 2 ≤ 1 + rho ^ 2 by linarith)
    rwa [Real.sqrt_sq_eq_abs, abs_of_pos hrpos] at h
  have hs3 : rho ^ 3 ≤ Real.sqrt (1 + rho ^ 2) ^ 3 :=
    pow_le_pow_left₀ hrpos.le hsge 3
  have hcut : cutoff rho ≤ 1 := Real.smoothTransition.le_one _
  calc
    Real.sqrt rho * (cutoff rho * rho /
        Real.sqrt (1 + rho ^ 2) ^ 3) ≤
        (Real.sqrt rho * rho) /
          Real.sqrt (1 + rho ^ 2) ^ 3 := by
      rw [show Real.sqrt rho * (cutoff rho * rho /
          Real.sqrt (1 + rho ^ 2) ^ 3) =
        (Real.sqrt rho * (cutoff rho * rho)) /
          Real.sqrt (1 + rho ^ 2) ^ 3 by ring]
      apply div_le_div_of_nonneg_right
      · exact mul_le_mul_of_nonneg_left
          (by simpa using mul_le_mul_of_nonneg_right hcut hrpos.le)
          (Real.sqrt_nonneg rho)
      · positivity
    _ ≤ (Real.sqrt rho * rho) / rho ^ 3 :=
      div_le_div_of_nonneg_left (by positivity) (pow_pos hrpos 3) hs3
    _ = rho ^ (-(3 / 2 : ℝ)) := by
      rw [Real.sqrt_eq_rpow]
      calc
        rho ^ (1 / 2 : ℝ) * rho / rho ^ 3 =
            rho ^ ((1 / 2 : ℝ) + 1) / rho ^ (3 : ℝ) := by
          rw [Real.rpow_add hrpos]
          norm_num [Real.rpow_one, Real.rpow_natCast]
        _ = rho ^ (((1 / 2 : ℝ) + 1) - 3) := by
          rw [Real.rpow_sub hrpos]
        _ = rho ^ (-(3 / 2 : ℝ)) := by norm_num

theorem affineHartreeWeight_integrable :
    Integrable affineHartreeWeight := by
  have hpow : IntegrableOn (fun rho : ℝ => rho ^ (-(2 : ℝ))) (Ioi 1) :=
    integrableOn_Ioi_rpow_of_lt (by norm_num) zero_lt_one
  have htail : IntegrableOn affineHartreeWeight (Ioi 1) := by
    refine hpow.mono' affineHartreeWeight_aestronglyMeasurable.restrict ?_
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with rho hrho
    rw [Real.norm_eq_abs,
      abs_of_nonneg (affineHartreeWeight_nonneg rho)]
    exact affineHartreeWeight_le_rpow rho hrho
  have hi := htail.integrable_indicator measurableSet_Ioi
  refine hi.congr (Filter.Eventually.of_forall fun rho => ?_)
  by_cases hrho : 1 < rho
  · simp [Set.indicator, hrho]
  · have hw := affineHartreeWeight_zero_of_le_one rho (le_of_not_gt hrho)
    simp [Set.indicator, hrho, hw]

theorem affineHartreeSqrtWeight_integrable :
    Integrable affineHartreeSqrtWeight := by
  have hpow : IntegrableOn
      (fun rho : ℝ => rho ^ (-(3 / 2 : ℝ))) (Ioi 1) :=
    integrableOn_Ioi_rpow_of_lt (by norm_num) zero_lt_one
  have htail : IntegrableOn affineHartreeSqrtWeight (Ioi 1) := by
    refine hpow.mono' affineHartreeSqrtWeight_aestronglyMeasurable.restrict ?_
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with rho hrho
    rw [Real.norm_eq_abs,
      abs_of_nonneg (affineHartreeSqrtWeight_nonneg rho)]
    exact affineHartreeSqrtWeight_le_rpow rho hrho
  have hi := htail.integrable_indicator measurableSet_Ioi
  refine hi.congr (Filter.Eventually.of_forall fun rho => ?_)
  by_cases hrho : 1 < rho
  · simp [Set.indicator, hrho]
  · have hw := affineHartreeSqrtWeight_zero_of_le_one rho (le_of_not_gt hrho)
    simp [Set.indicator, hrho, hw]

/-- One-sided representation used to prove integrability of the diagonal
square-root kernel. -/
def oneSidedSqrtKernel (x : ℝ) : ℝ :=
  (Ioo (0 : ℝ) 1).indicator (fun y => y ^ (-(1 / 2 : ℝ))) x

theorem oneSidedSqrtKernel_integrable :
    Integrable oneSidedSqrtKernel := by
  unfold oneSidedSqrtKernel
  exact ((intervalIntegral.integrableOn_Ioo_rpow_iff zero_lt_one).2
    (by norm_num)).integrable_indicator measurableSet_Ioo

theorem diagonalSqrtKernel_eq_oneSided (x : ℝ) :
    diagonalSqrtKernel x =
      oneSidedSqrtKernel x + oneSidedSqrtKernel (-x) := by
  by_cases hx : x = 0
  · simp [hx, diagonalSqrtKernel, oneSidedSqrtKernel]
  rcases lt_or_gt_of_ne hx with hxneg | hxpos
  · have hnxpos : 0 < -x := neg_pos.mpr hxneg
    have hxnot : x ∉ Ioo (0 : ℝ) 1 := by simp [not_lt_of_ge hxneg.le]
    by_cases hnxone : -x < 1
    · have habs : |x| < 1 := by simpa [abs_of_neg hxneg]
      simp only [diagonalSqrtKernel, habs, ↓reduceIte]
      rw [abs_of_neg hxneg, Real.sqrt_eq_rpow, ← Real.rpow_neg hnxpos.le]
      simp [oneSidedSqrtKernel, Set.indicator, hxnot, hnxpos, hnxone]
    · have hnxge : 1 ≤ -x := le_of_not_gt hnxone
      have habs : ¬|x| < 1 := by
        rw [abs_of_neg hxneg]
        exact not_lt_of_ge hnxge
      have hnxnot : -x ∉ Ioo (0 : ℝ) 1 := by
        intro hmem
        exact hnxone hmem.2
      simp [diagonalSqrtKernel, habs, oneSidedSqrtKernel,
        Set.indicator, hxnot, hnxnot]
  · have hxnot : -x ∉ Ioo (0 : ℝ) 1 := by simp [not_lt_of_ge hxpos.le]
    by_cases hxone : x < 1
    · have habs : |x| < 1 := by simpa [abs_of_pos hxpos]
      simp only [diagonalSqrtKernel, habs, ↓reduceIte]
      rw [abs_of_pos hxpos, Real.sqrt_eq_rpow, ← Real.rpow_neg hxpos.le]
      simp [oneSidedSqrtKernel, Set.indicator, hxnot, hxpos, hxone]
    · have hxge : 1 ≤ x := le_of_not_gt hxone
      have habs : ¬|x| < 1 := by
        rw [abs_of_pos hxpos]
        exact not_lt_of_ge hxge
      have hxnot' : x ∉ Ioo (0 : ℝ) 1 := by
        intro hmem
        exact hxone hmem.2
      simp [diagonalSqrtKernel, habs, oneSidedSqrtKernel,
        Set.indicator, hxnot', hxnot]

theorem diagonalSqrtKernel_integrable :
    Integrable diagonalSqrtKernel := by
  have hsum := oneSidedSqrtKernel_integrable.add
    oneSidedSqrtKernel_integrable.comp_neg
  apply hsum.congr
  filter_upwards with x
  exact (diagonalSqrtKernel_eq_oneSided x).symm

theorem diagonalSqrtKernel_nonneg (x : ℝ) :
    0 ≤ diagonalSqrtKernel x := by
  unfold diagonalSqrtKernel
  split_ifs
  · positivity
  · exact le_rfl

/-- The positive-half-line logarithm in the radial Hartree kernel. -/
def hartreeRadialLog (r rho : ℝ) : ℝ :=
  Real.log ((r + rho) / |r - rho|)

theorem hartreeRadialLog_nonneg
    (r rho : ℝ) (hr : 0 < r) (hrho : 0 < rho) :
    0 ≤ hartreeRadialLog r rho := by
  unfold hartreeRadialLog
  by_cases hdiag : r = rho
  · subst rho
    simp
  · have hdpos : 0 < |r - rho| := abs_pos.mpr (sub_ne_zero.mpr hdiag)
    have hdle : |r - rho| ≤ r + rho := by
      rw [abs_le]
      constructor <;> linarith
    have hmul : (1 : ℝ) * |r - rho| ≤ r + rho := by simpa using hdle
    exact Real.log_nonneg ((le_div_iff₀ hdpos).2 hmul)

theorem hartreeRadialLog_sqrt_bound
    (r rho : ℝ) (hr : 0 < r) (hrho : 0 < rho) :
    hartreeRadialLog r rho ≤
      2 * (Real.sqrt r + Real.sqrt rho) *
        (Real.sqrt |r - rho|)⁻¹ := by
  have hsum : 0 ≤ r + rho := by linarith
  have hquot : 0 ≤ (r + rho) / |r - rho| :=
    div_nonneg hsum (abs_nonneg _)
  have hlog := Real.log_le_rpow_div hquot (show 0 < (1 / 2 : ℝ) by norm_num)
  have hlog' : hartreeRadialLog r rho ≤
      2 * Real.sqrt ((r + rho) / |r - rho|) := by
    unfold hartreeRadialLog
    calc
      Real.log ((r + rho) / |r - rho|) ≤
          ((r + rho) / |r - rho|) ^ (1 / 2 : ℝ) / (1 / 2 : ℝ) := hlog
      _ = 2 * Real.sqrt ((r + rho) / |r - rho|) := by
        rw [Real.sqrt_eq_rpow]
        ring
  have hsqrtadd : Real.sqrt (r + rho) ≤
      Real.sqrt r + Real.sqrt rho := by
    rw [Real.sqrt_le_iff]
    constructor
    · positivity
    · nlinarith [Real.sq_sqrt hr.le, Real.sq_sqrt hrho.le,
        mul_nonneg (Real.sqrt_nonneg r) (Real.sqrt_nonneg rho)]
  calc
    hartreeRadialLog r rho ≤
        2 * Real.sqrt ((r + rho) / |r - rho|) := hlog'
    _ = 2 * (Real.sqrt (r + rho) / Real.sqrt |r - rho|) := by
      rw [Real.sqrt_div hsum]
    _ ≤ 2 * ((Real.sqrt r + Real.sqrt rho) /
        Real.sqrt |r - rho|) := by
      gcongr
    _ = 2 * (Real.sqrt r + Real.sqrt rho) *
        (Real.sqrt |r - rho|)⁻¹ := by ring

theorem hartreeRadialLog_near_bound
    (r rho : ℝ) (hr : 0 < r) (hrho : 0 < rho)
    (hnear : |r - rho| < 1) :
    hartreeRadialLog r rho ≤
      2 * (Real.sqrt r + Real.sqrt rho) *
        diagonalSqrtKernel (r - rho) := by
  simp only [diagonalSqrtKernel, hnear, ↓reduceIte]
  exact hartreeRadialLog_sqrt_bound r rho hr hrho

theorem hartreeRadialLog_far_bound
    (r rho : ℝ) (hr : 0 < r) (hrho : 0 < rho)
    (hfar : 1 ≤ |r - rho|) :
    hartreeRadialLog r rho ≤
      2 * (Real.sqrt r + Real.sqrt rho) := by
  have hsqrt : 1 ≤ Real.sqrt |r - rho| := by
    have h := Real.sqrt_le_sqrt hfar
    simpa using h
  have hinv : (Real.sqrt |r - rho|)⁻¹ ≤ 1 :=
    (inv_le_one₀ (by positivity : 0 < Real.sqrt |r - rho|)).2 hsqrt
  calc
    hartreeRadialLog r rho ≤
        2 * (Real.sqrt r + Real.sqrt rho) *
          (Real.sqrt |r - rho|)⁻¹ :=
      hartreeRadialLog_sqrt_bound r rho hr hrho
    _ ≤ 2 * (Real.sqrt r + Real.sqrt rho) := by
      nlinarith [Real.sqrt_nonneg r, Real.sqrt_nonneg rho]

/-- Integrable product majorant for the near-diagonal part. -/
def hartreeNearMajorant (p : ℝ × ℝ) : ℝ :=
  scaleHartreeSqrtWeight p.1 * affineHartreeWeight p.2 *
      diagonalSqrtKernel (p.1 - p.2) +
    scaleHartreeWeight p.1 * affineHartreeSqrtWeight p.2 *
      diagonalSqrtKernel (p.1 - p.2)

/-- Integrable separable majorant away from the diagonal. -/
def hartreeFarMajorant (p : ℝ × ℝ) : ℝ :=
  scaleHartreeSqrtWeight p.1 * affineHartreeWeight p.2 +
    scaleHartreeWeight p.1 * affineHartreeSqrtWeight p.2

theorem hartreeNearMajorant_nonneg (p : ℝ × ℝ) :
    0 ≤ hartreeNearMajorant p := by
  unfold hartreeNearMajorant
  exact add_nonneg
    (mul_nonneg (mul_nonneg (scaleHartreeSqrtWeight_nonneg _)
      (affineHartreeWeight_nonneg _)) (diagonalSqrtKernel_nonneg _))
    (mul_nonneg (mul_nonneg (scaleHartreeWeight_nonneg _)
      (affineHartreeSqrtWeight_nonneg _)) (diagonalSqrtKernel_nonneg _))

theorem hartreeFarMajorant_nonneg (p : ℝ × ℝ) :
    0 ≤ hartreeFarMajorant p := by
  unfold hartreeFarMajorant
  exact add_nonneg
    (mul_nonneg (scaleHartreeSqrtWeight_nonneg _)
      (affineHartreeWeight_nonneg _))
    (mul_nonneg (scaleHartreeWeight_nonneg _)
      (affineHartreeSqrtWeight_nonneg _))

theorem hartreeNearMajorant_integrable :
    Integrable hartreeNearMajorant (volume.prod volume) := by
  have hconv0 : Integrable
      (fun p : ℝ × ℝ => affineHartreeWeight p.2 *
        diagonalSqrtKernel (p.1 - p.2)) (volume.prod volume) := by
    simpa only [ContinuousLinearMap.mul_apply'] using
      affineHartreeWeight_integrable.convolution_integrand
        (ContinuousLinearMap.mul ℝ ℝ) diagonalSqrtKernel_integrable
  have hconv1 : Integrable
      (fun p : ℝ × ℝ => affineHartreeSqrtWeight p.2 *
        diagonalSqrtKernel (p.1 - p.2)) (volume.prod volume) := by
    simpa only [ContinuousLinearMap.mul_apply'] using
      affineHartreeSqrtWeight_integrable.convolution_integrand
        (ContinuousLinearMap.mul ℝ ℝ) diagonalSqrtKernel_integrable
  have hnear0 := hconv0.bdd_mul
    (scaleHartreeSqrtWeight_continuous.comp continuous_fst).aestronglyMeasurable
    (Filter.Eventually.of_forall fun p : ℝ × ℝ =>
      scaleHartreeSqrtWeight_le_one p.1)
  have hnear1 := hconv1.bdd_mul
    (scaleHartreeWeight_continuous.comp continuous_fst).aestronglyMeasurable
    (Filter.Eventually.of_forall fun p : ℝ × ℝ =>
      scaleHartreeWeight_le_one p.1)
  change Integrable (fun p : ℝ × ℝ =>
    scaleHartreeSqrtWeight p.1 * affineHartreeWeight p.2 *
        diagonalSqrtKernel (p.1 - p.2) +
      scaleHartreeWeight p.1 * affineHartreeSqrtWeight p.2 *
        diagonalSqrtKernel (p.1 - p.2)) (volume.prod volume)
  refine (hnear0.add hnear1).congr ?_
  filter_upwards with p
  simp [Function.comp_apply, mul_assoc]

theorem hartreeFarMajorant_integrable :
    Integrable hartreeFarMajorant (volume.prod volume) := by
  have h0 := scaleHartreeSqrtWeight_integrable.mul_prod
    affineHartreeWeight_integrable
  have h1 := scaleHartreeWeight_integrable.mul_prod
    affineHartreeSqrtWeight_integrable
  change Integrable (fun p : ℝ × ℝ =>
    scaleHartreeSqrtWeight p.1 * affineHartreeWeight p.2 +
      scaleHartreeWeight p.1 * affineHartreeSqrtWeight p.2)
    (volume.prod volume)
  refine (h0.add h1).congr ?_
  filter_upwards with p
  simp

/-- A single integrable majorant valid on both sides of the diagonal
decomposition. -/
def hartreeProductMajorant (p : ℝ × ℝ) : ℝ :=
  2 * |8 * Real.pi * hartreeKappa| *
    (hartreeNearMajorant p + hartreeFarMajorant p)

theorem hartreeProductMajorant_nonneg (p : ℝ × ℝ) :
    0 ≤ hartreeProductMajorant p := by
  unfold hartreeProductMajorant
  exact mul_nonneg (mul_nonneg (by norm_num) (abs_nonneg _))
    (add_nonneg (hartreeNearMajorant_nonneg p)
      (hartreeFarMajorant_nonneg p))

theorem hartreeProductMajorant_integrable :
    Integrable hartreeProductMajorant (volume.prod volume) := by
  have hsum := hartreeNearMajorant_integrable.add
    hartreeFarMajorant_integrable
  have h := hsum.const_mul (2 * |8 * Real.pi * hartreeKappa|)
  change Integrable (fun p : ℝ × ℝ =>
    2 * |8 * Real.pi * hartreeKappa| *
      (hartreeNearMajorant p + hartreeFarMajorant p))
    (volume.prod volume)
  refine h.congr ?_
  filter_upwards with p
  simp

theorem hartreeProduct_norm_eq_weights
    (r rho : ℝ) (hr : 0 < r) (hrho : 0 < rho) :
    ‖resonancePlus r * hartreeKernel r rho * model rho‖ =
      |8 * Real.pi * hartreeKappa| *
        scaleHartreeWeight r * affineHartreeWeight rho *
          hartreeRadialLog r rho := by
  have hlog : 0 ≤ Real.log ((r + rho) / |r - rho|) :=
    hartreeRadialLog_nonneg r rho hr hrho
  rw [Real.norm_eq_abs]
  unfold hartreeKernel scaleHartreeWeight affineHartreeWeight hartreeRadialLog
  simp only [abs_mul, abs_of_nonneg hlog]
  ring

theorem hartreeProduct_norm_le_majorant
    (r rho : ℝ) (hr : 0 < r) (hrho : 0 < rho) :
    ‖resonancePlus r * hartreeKernel r rho * model rho‖ ≤
      hartreeProductMajorant (r, rho) := by
  rw [hartreeProduct_norm_eq_weights r rho hr hrho]
  have hfac : 0 ≤ |8 * Real.pi * hartreeKappa| *
      scaleHartreeWeight r * affineHartreeWeight rho :=
    mul_nonneg
      (mul_nonneg (abs_nonneg _) (scaleHartreeWeight_nonneg r))
      (affineHartreeWeight_nonneg rho)
  by_cases hnear : |r - rho| < 1
  · have hlog := hartreeRadialLog_near_bound r rho hr hrho hnear
    calc
      |8 * Real.pi * hartreeKappa| * scaleHartreeWeight r *
          affineHartreeWeight rho * hartreeRadialLog r rho ≤
          (|8 * Real.pi * hartreeKappa| * scaleHartreeWeight r *
            affineHartreeWeight rho) *
            (2 * (Real.sqrt r + Real.sqrt rho) *
              diagonalSqrtKernel (r - rho)) :=
        mul_le_mul_of_nonneg_left hlog hfac
      _ = 2 * |8 * Real.pi * hartreeKappa| *
          hartreeNearMajorant (r, rho) := by
        unfold hartreeNearMajorant scaleHartreeSqrtWeight
          affineHartreeSqrtWeight
        ring
      _ ≤ hartreeProductMajorant (r, rho) := by
        unfold hartreeProductMajorant
        have hC : 0 ≤ 2 * |8 * Real.pi * hartreeKappa| :=
          mul_nonneg (by norm_num) (abs_nonneg _)
        exact mul_le_mul_of_nonneg_left
          (le_add_of_nonneg_right (hartreeFarMajorant_nonneg (r, rho))) hC
  · have hfar : 1 ≤ |r - rho| := le_of_not_gt hnear
    have hlog := hartreeRadialLog_far_bound r rho hr hrho hfar
    calc
      |8 * Real.pi * hartreeKappa| * scaleHartreeWeight r *
          affineHartreeWeight rho * hartreeRadialLog r rho ≤
          (|8 * Real.pi * hartreeKappa| * scaleHartreeWeight r *
            affineHartreeWeight rho) *
            (2 * (Real.sqrt r + Real.sqrt rho)) :=
        mul_le_mul_of_nonneg_left hlog hfac
      _ = 2 * |8 * Real.pi * hartreeKappa| *
          hartreeFarMajorant (r, rho) := by
        unfold hartreeFarMajorant scaleHartreeSqrtWeight
          affineHartreeSqrtWeight
        ring
      _ ≤ hartreeProductMajorant (r, rho) := by
        unfold hartreeProductMajorant
        have hC : 0 ≤ 2 * |8 * Real.pi * hartreeKappa| :=
          mul_nonneg (by norm_num) (abs_nonneg _)
        exact mul_le_mul_of_nonneg_left
          (le_add_of_nonneg_left (hartreeNearMajorant_nonneg (r, rho))) hC

theorem resonancePlus_measurable : Measurable resonancePlus := by
  have heq : resonancePlus = fun r : ℝ =>
      r * ((1 - r ^ 2) /
        (2 * Real.sqrt (1 + r ^ 2) ^ 3)) := by
    funext r
    rw [resonancePlus_def, dilationGenerator_bubble_closed]
  rw [heq]
  exact (by
    fun_prop (discharger := intro; positivity) :
      Continuous (fun r : ℝ =>
        r * ((1 - r ^ 2) /
          (2 * Real.sqrt (1 + r ^ 2) ^ 3)))).measurable

theorem hartreeKernel_uncurry_measurable :
    Measurable (Function.uncurry hartreeKernel) := by
  unfold Function.uncurry hartreeKernel bubble
  measurability

theorem hartreeScaleAffineDensity_measurable :
    Measurable (Function.uncurry (fun r rho =>
      resonancePlus r * hartreeKernel r rho * model rho)) := by
  exact ((resonancePlus_measurable.comp measurable_fst).mul
    hartreeKernel_uncurry_measurable).mul
      (model_contDiff_infty.continuous.measurable.comp measurable_snd)

/-- The exact density needed for the nonlocal Green commutator is absolutely
integrable on the positive quadrant. -/
theorem hartree_scale_affine_product_integrable :
    Integrable
      (Function.uncurry (fun r rho =>
        resonancePlus r * hartreeKernel r rho * model rho))
      ((volume.restrict (Ioi (0 : ℝ))).prod
        (volume.restrict (Ioi (0 : ℝ)))) := by
  rw [Measure.prod_restrict]
  have hmajor : Integrable hartreeProductMajorant
      ((volume.prod volume).restrict
        (Ioi (0 : ℝ) ×ˢ Ioi (0 : ℝ))) :=
    hartreeProductMajorant_integrable.integrableOn
  refine hmajor.mono'
    hartreeScaleAffineDensity_measurable.aestronglyMeasurable.restrict ?_
  filter_upwards [ae_restrict_mem
    (measurableSet_Ioi.prod measurableSet_Ioi)] with p hp
  exact hartreeProduct_norm_le_majorant p.1 p.2 hp.1 hp.2

/-- Unconditional nonlocal symmetry for the scale resonance and affine
cutoff.  This is the commutator term omitted from the original finite-radius
Green calculation. -/
theorem hartree_scale_affine_pairing :
    (∫ r in Ioi (0 : ℝ),
      resonancePlus r * nonlocalApply model r) =
      ∫ r in Ioi (0 : ℝ),
        model r * nonlocalApply resonancePlus r :=
  hartree_scale_affine_pairing_of_integrable
    hartree_scale_affine_product_integrable

end HBL.Modulation.AffineTail
