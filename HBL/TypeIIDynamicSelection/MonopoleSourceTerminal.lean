import HBL.MonopoleThresholdProjection
import HBL.TypeIIDynamicSelection.ClockIdentities

/-!
# Actual Hartree-monopole projection -> emergent terminal parameter

This file proves a necessary, noncircular piece of the dynamically selected
Type II rate mechanism. It uses the ACTUAL normalized plus/minus compact
threshold projection of the true Hartree monopole *approximate-profile
effective increment*, including its radial nonlocal potential.

The source is known integrable under explicit primitive-path decay. We
integrate that source to obtain terminal parameters as OUTPUTS. No
asymptotic speed, mu_infty or theta_infty is assumed or prescribed.

IMPORTANT: This does not prove that these approximate-profile-driven
modulation coordinates are those of an EXACT Hartree PDE solution. The
unconstructed physical three-region residual and feedback remain mandatory.
-/

noncomputable section
set_option autoImplicit false
open Set MeasureTheory Filter
open scoped Topology

namespace HBL.TypeIIDynamicSelection
open HBL.Modulation.Monopole

/-- Real scale-coordinate path generated by the actual Hartree-monopole
residual's fixed normalized radial test; the initial value is free. -/
def monopoleSourceDrivenMu (c b omega : ℝ → ℝ) (s0 mu0 : ℝ) (s : ℝ) : ℝ :=
  mu0 + ∫ t in s0..s, monopoleThresholdCoordinatePlus c b omega t

/-- Real phase-coordinate path driven by the imaginary Hartree-monopole
residual test, with no prescribed terminal phase. -/
def monopoleSourceDrivenTheta (c b omega : ℝ → ℝ) (s0 theta0 : ℝ)
    (s : ℝ) : ℝ :=
  theta0 + ∫ t in s0..s, monopoleThresholdCoordinateMinus c b omega t

/-- For primitive monopole paths meeting the already proved actual
Hartree cutoff-source estimates, BOTH asymptotic modulation coordinates
exist, and both are given by exact time integrals of the physical source.
No value of either limiting coordinate is assumed. -/
theorem actual_monopole_source_selects_terminal_coordinates
    {c b omega : ℝ → ℝ} {s0 beta A : ℝ}
    (hs0 : 0 < s0) (hbeta : 1 / 2 < beta) (hA : 0 ≤ A)
    (hc : Differentiable ℝ c) (hb : Measurable b) (homega : Measurable omega)
    (hsmall : ∀ s : ℝ, s0 < s → |c s| ≤ 1)
    (hdecay : ∀ s : ℝ, s0 < s →
      |c s| ≤ A * s ^ (-beta) ∧ |deriv c s| ≤ A * s ^ (-1 - beta) ∧
      |b s| ≤ A * s ^ (-1 : ℝ) ∧ |omega s| ≤ A * s ^ (-1 : ℝ))
    (mu0 theta0 : ℝ) :
    ∃ muInf thetaInf : ℝ,
      muInf = mu0 +
        ∫ t in Ioi s0, monopoleThresholdCoordinatePlus c b omega t ∧
      thetaInf = theta0 +
        ∫ t in Ioi s0, monopoleThresholdCoordinateMinus c b omega t ∧
      Tendsto (monopoleSourceDrivenMu c b omega s0 mu0)
        atTop (𝓝 muInf) ∧
      Tendsto (monopoleSourceDrivenTheta c b omega s0 theta0)
        atTop (𝓝 thetaInf) := by
  obtain ⟨_, hplus, hminus⟩ :=
    monopoleThresholdCoordinates_integrable hs0 hbeta hA
      hc hb homega hsmall hdecay
  refine ⟨mu0 + ∫ t in Ioi s0, monopoleThresholdCoordinatePlus c b omega t,
    theta0 + ∫ t in Ioi s0, monopoleThresholdCoordinateMinus c b omega t,
    rfl, rfl, ?_, ?_⟩
  · have ht := intervalIntegral_tendsto_integral_Ioi s0 hplus
      (tendsto_id : Tendsto (fun s : ℝ => s) atTop atTop)
    simpa only [monopoleSourceDrivenMu] using
      (tendsto_const_nhds.add ht : Tendsto
        (fun s : ℝ => mu0 +
          ∫ t in s0..s, monopoleThresholdCoordinatePlus c b omega t)
        atTop (𝓝 (mu0 +
          ∫ t in Ioi s0, monopoleThresholdCoordinatePlus c b omega t)))
  · have ht := intervalIntegral_tendsto_integral_Ioi s0 hminus
      (tendsto_id : Tendsto (fun s : ℝ => s) atTop atTop)
    simpa only [monopoleSourceDrivenTheta] using
      (tendsto_const_nhds.add ht : Tendsto
        (fun s : ℝ => theta0 +
          ∫ t in s0..s, monopoleThresholdCoordinateMinus c b omega t)
        atTop (𝓝 (theta0 +
          ∫ t in Ioi s0, monopoleThresholdCoordinateMinus c b omega t)))

end HBL.TypeIIDynamicSelection
