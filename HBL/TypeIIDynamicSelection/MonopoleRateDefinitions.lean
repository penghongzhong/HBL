import HBL.MonopoleThresholdProjection
import HBL.TypeIIDynamicSelection.ClockIdentities
import HBL.KinematicTailEstimates

/-!
# Real Hartree first-monopole projected rate — definitions
The integrand is the ACTUAL radial first-correction Hartree threshold projection
constructed in HBL.MonopoleThresholdProjection; it is not the full nonlinear
residual of an as-yet unconstructed blowup orbit.

The effective modulation candidate is obtained by integration of that actual
source. The hard PDE identification of this candidate with the true two-channel
modulation of an exact Hartree solution is NOT claimed here.
-/

noncomputable section
set_option autoImplicit false
open Set MeasureTheory Filter
open scoped Topology

namespace HBL.TypeIIDynamicSelection

open HBL.Modulation.Monopole

def firstMonopoleRealProjectedSource
    (c b omega : ℝ → ℝ) (s : ℝ) : ℝ :=
  monopoleThresholdCoordinatePlus c b omega s

/-- Normalized first-monopole modulation candidate, with no predetermined
terminal value or target exponent. -/
def firstMonopoleDrivenMu (mu0 s0 : ℝ) (c b omega : ℝ → ℝ)
    (s : ℝ) : ℝ :=
  mu0 + ∫ t in s0..s, firstMonopoleRealProjectedSource c b omega t

/-- Its terminal limit is generated by an integral of a genuine physical
first-order Hartree threshold source, rather than prescribed as a parameter. -/
def firstMonopoleDrivenMuInfinity (mu0 s0 : ℝ) (c b omega : ℝ → ℝ) : ℝ :=
  mu0 + ∫ t in Ioi s0, firstMonopoleRealProjectedSource c b omega t

end HBL.TypeIIDynamicSelection
