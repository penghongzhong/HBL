import HBL.TypeIIDynamicSelection.ActualHartreeTrueSourceSelectedFullSingularOriginalNorm
import HBL.TypeIIDynamicSelection.ActualHartreeSelectedAdjustedRegularGreenAllRadii
import Mathlib.Tactic

/-!
# Complete original source-driven adjusted Green field, common real two-speed

This composes the true full singular Green channel, the true adjusted
regular Green coefficient at EVERY normalized radius, and the original
Green decomposition using the SAME uniquely compatible real speed
generated by the original three-dimensional nonlocal Hartree source.

There is no OriginBasisOn-dependent inverse left radius in the resulting
weighted WHOLE Green estimate. Its physical Fredholm sources and its
two-channel compatibility selector are literal. This is a fixed-time
inner Kummer Green result: the matched homogeneous Cramer channel,
moving basis derivatives, three C¹ interface joins, true four-region
PDE residual and physical finite induction remain separate.
-/

noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1600000

open Set MeasureTheory Filter
open scoped Topology

namespace HBL.TypeIIDynamicSelection
open HBL.Profile.Kummer
open HBL.Modulation HBL.Modulation.Monopole HBL.Modulation.AffineTail
open HBL.Profile.ActualInner HBL.L2Kernel

/-- Actual nonlocal source → unique real speed → full singular and
regular original Wronskian fields → radius-weighted complete Green bound.
Every constant is generated from the source-side strict producers. -/
theorem actual_Hartree_true_source_selected_whole_original_Green_no_radius_loss
    {mu theta scale : ℝ} (K : OriginKummerPair mu theta scale)
    (D G B : ℝ) (hD : 0 ≤ D) (hG : 0 ≤ G)
    (hB : 0 < B) (hBOne : B ≤ 1) (hBR : B < scale)
    (hcoeff : ∀ x ∈ Icc 0 scale,
      ‖originFirstCoeff x‖ + ‖originZeroCoeff mu theta‖ ≤ D)
    (hbound : ∀ x ∈ Icc 0 scale,
      ‖K.y x‖ ≤ G ∧ ‖K.dy x‖ ≤ G ∧
        ‖K.x x‖ ≤ G ∧ ‖K.dx x‖ ≤ G)
    (hsmallB : ((D + 1) * G + 1 / 4) * B ^ 2 ≤ 1) :
    ∃ L0 epsilon C Cs Cn Csel Csp : ℝ,
      6 ≤ L0 ∧ 0 < epsilon ∧ epsilon ≤ 1 ∧
      0 < C ∧ 0 < Cs ∧ 0 < Cn ∧ 0 < Csel ∧ 0 < Csp ∧
      ∀ (L c a : ℝ) (hLp : 0 < L),
        L0 ≤ L → L ^ 3 ≤ a → a * |c| ≤ epsilon →
        L / a ≤ B →
      ∀ (Fp Fm : ℝ → ℝ)
        (hp : InWeightedL2 (7 / 4 : ℝ) Fp)
        (hm : InWeightedL2 (7 / 4 : ℝ) Fm),
        Continuous Fp → Continuous Fm →
      ∀ (Bz Az ell : ℝ), 0 ≤ Bz → 0 ≤ Az →
        0 < ell → ell ≤ 1 →
      ∀ (z : ℝ → ℂ), Measurable z →
        (∀ y : ℝ, 0 < y → ‖z y‖ ≤ Bz) →
        (∀ y : ℝ, 1 ≤ y → y * ‖z y‖ ≤ Az) →
      let F0 : ℝ → ℂ :=
        fun x => -actualHartreeLaplacianScaledKummerSource a ell c z x
      let Q : ℝ :=
        actualHartreePhysicalWeightedSourceConstant Bz Az *
          ell ^ (1 / 8 : ℝ)
      let N : ℝ :=
        innerWeightedNorm (7 / 4 : ℝ) Fp +
          innerWeightedNorm (7 / 4 : ℝ) Fm
      let Cr : ℝ := 1 + (D + 1) * G * (B ^ 2 + 2)
      let Cp : ℝ := 1 + (D + 1) * G * B ^ 2
      let Cf : ℝ :=
        actualInnerShellValueConstant + actualInnerShellDerivativeConstant
      ∃ p : ℝ × ℝ,
        actualMomentLockedCoupledCompatibility K L c hLp a (L / a) B
          Fp Fm hp hm F0 p.1 p.2 = 0 ∧
        (∀ q : ℝ × ℝ,
          actualMomentLockedCoupledCompatibility K L c hLp a (L / a) B
            Fp Fm hp hm F0 q.1 q.2 = 0 → q = p) ∧
        ∀ r ∈ Icc (L / a) B,
          let Fadj : ℝ → ℂ := fun x =>
            F0 x + (-(p.1 : ℂ)) * actualMomentLockedScaledScaleSource a c x +
              (-(p.2 : ℂ)) * actualMomentLockedScaledPhaseSource a c x
          ‖(r : ℂ) * originGreenValue K (L / a) B Fadj r‖ ≤
            B * ((G * Cr * Cf * Cn + G * Cp + G ^ 2 * Cs * C) * (N + Q)) +
              G * ((((8 / 3 : ℝ) * G * Q) * L ^ (-(3 / 8 : ℝ))) +
                (Csp * G * B * Csel) * (N + Q)) := by
  obtain ⟨Ls, es, C, Cs, Cn,
    hLs, hes, hesOne, hC, hCs, hCn, hSingAll⟩ :=
    actual_Hartree_true_source_selected_full_singular_original_norm_gain
      K D G B hD hG hB hBOne hBR hcoeff hbound hsmallB
  obtain ⟨Lr, er, Csel, Csp,
    hLr, her, herOne, hCsel, hCsp, hRegAll⟩ :=
    actual_Hartree_true_source_selected_adjusted_regular_Green_all_radii
      K D G B hD hG hB hBOne hBR hcoeff hbound hsmallB
  let L0 := max Ls Lr
  let epsilon := min es er
  have hL0 : 6 ≤ L0 := hLs.trans (le_max_left _ _)
  have heps : 0 < epsilon := lt_min hes her
  have hepsOne : epsilon ≤ 1 := (min_le_left _ _).trans hesOne
  refine ⟨L0, epsilon, C, Cs, Cn, Csel, Csp,
    hL0, heps, hepsOne, hC, hCs, hCn, hCsel, hCsp, ?_⟩
  intro L c a hLp hLarge ha3 hSmall hOrder
    Fp Fm hp hm hcp hcm Bz Az ell hBz hAz hell hellOne
    z hz hSup hStrauss
  dsimp only
  have hLargeS : Ls ≤ L := (le_max_left _ _).trans hLarge
  have hLargeR : Lr ≤ L := (le_max_right _ _).trans hLarge
  have hSmallS : a * |c| ≤ es := hSmall.trans (min_le_left _ _)
  have hSmallR : a * |c| ≤ er := hSmall.trans (min_le_right _ _)
  obtain ⟨p, hCompat, hUnique, hSing⟩ :=
    hSingAll L c a hLp hLargeS ha3 hSmallS hOrder
      Fp Fm hp hm hcp hcm Bz Az ell hBz hAz hell hellOne
      z hz hSup hStrauss
  obtain ⟨q, hCompatQ, _hUniqueQ, hReg⟩ :=
    hRegAll L c a hLp hLargeR ha3 hSmallR hOrder
      Fp Fm hp hm hcp hcm Bz Az ell hBz hAz hell hellOne
      z hz hSup hStrauss
  have hqp : q = p := hUnique q hCompatQ
  subst q
  refine ⟨p, hCompat, hUnique, ?_⟩
  let F0 : ℝ → ℂ :=
    fun x => -actualHartreeLaplacianScaledKummerSource a ell c z x
  let Q : ℝ :=
    actualHartreePhysicalWeightedSourceConstant Bz Az * ell ^ (1 / 8 : ℝ)
  let N : ℝ :=
    innerWeightedNorm (7 / 4 : ℝ) Fp +
      innerWeightedNorm (7 / 4 : ℝ) Fm
  let Cr : ℝ := 1 + (D + 1) * G * (B ^ 2 + 2)
  let Cp : ℝ := 1 + (D + 1) * G * B ^ 2
  let Cf : ℝ :=
    actualInnerShellValueConstant + actualInnerShellDerivativeConstant
  intro r hr
  let Fadj : ℝ → ℂ := fun x =>
    F0 x + (-(p.1 : ℂ)) * actualMomentLockedScaledScaleSource a c x +
      (-(p.2 : ℂ)) * actualMomentLockedScaledPhaseSource a c x
  let S : ℝ :=
    (G * Cr * Cf * Cn + G * Cp + G ^ 2 * Cs * C) * (N + Q)
  let T : ℝ :=
    (((8 / 3 : ℝ) * G * Q) * L ^ (-(3 / 8 : ℝ))) +
      (Csp * G * B * Csel) * (N + Q)
  have hS :
      ‖originPhysicalValue K.y r *
          originGreenCoeffA K B Fadj r‖ ≤ S := by
    simpa only [S, Fadj, F0, Cr, Cp, Cf, Q, N] using hSing r hr
  have hT :
      ‖originGreenCoeffB K (L / a) Fadj r‖ ≤ T := by
    simpa only [T, Fadj, F0, Q, N] using hReg r hr
  have hSnonneg : 0 ≤ S :=
    (norm_nonneg (originPhysicalValue K.y r *
      originGreenCoeffA K B Fadj r)).trans hS
  have hTnonneg : 0 ≤ T :=
    (norm_nonneg (originGreenCoeffB K (L / a) Fadj r)).trans hT
  have ha : 0 < a := (pow_pos hLp 3).trans_le ha3
  have hr0 : 0 < L / a := div_pos hLp ha
  have hrpos : 0 < r := hr0.trans_le hr.1
  have hRC : (r : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hrpos.ne'
  have hNormR : ‖(r : ℂ)‖ = r := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hrpos]
  have hX : (r : ℂ) * originPhysicalValue K.x r = K.x r := by
    unfold originPhysicalValue
    field_simp [hRC]
  have hx : ‖K.x r‖ ≤ G :=
    (hbound r ⟨hrpos.le, hr.2.trans hBR.le⟩).2.2.1
  have hSplit :
      (r : ℂ) * originGreenValue K (L / a) B Fadj r =
        (r : ℂ) * (originPhysicalValue K.y r *
          originGreenCoeffA K B Fadj r) +
          K.x r * originGreenCoeffB K (L / a) Fadj r := by
    unfold originGreenValue
    calc
      _ = (r : ℂ) * (originPhysicalValue K.y r *
          originGreenCoeffA K B Fadj r) +
            ((r : ℂ) * originPhysicalValue K.x r) *
              originGreenCoeffB K (L / a) Fadj r := by ring
      _ = _ := by rw [hX]
  have hTriangle :
      ‖(r : ℂ) * originGreenValue K (L / a) B Fadj r‖ ≤
        r * ‖originPhysicalValue K.y r *
            originGreenCoeffA K B Fadj r‖ +
          G * ‖originGreenCoeffB K (L / a) Fadj r‖ := by
    rw [hSplit]
    calc
      ‖(r : ℂ) * (originPhysicalValue K.y r *
          originGreenCoeffA K B Fadj r) +
          K.x r * originGreenCoeffB K (L / a) Fadj r‖ ≤
        ‖(r : ℂ) * (originPhysicalValue K.y r *
          originGreenCoeffA K B Fadj r)‖ +
          ‖K.x r * originGreenCoeffB K (L / a) Fadj r‖ :=
            norm_add_le _ _
      _ = r * ‖originPhysicalValue K.y r *
          originGreenCoeffA K B Fadj r‖ +
          ‖K.x r‖ * ‖originGreenCoeffB K (L / a) Fadj r‖ := by
            simp only [norm_mul, hNormR]
      _ ≤ r * ‖originPhysicalValue K.y r *
          originGreenCoeffA K B Fadj r‖ +
          G * ‖originGreenCoeffB K (L / a) Fadj r‖ :=
            add_le_add_right
              (mul_le_mul_of_nonneg_right hx (norm_nonneg _)) _
  have hSingBudget :
      r * ‖originPhysicalValue K.y r *
          originGreenCoeffA K B Fadj r‖ ≤ B * S :=
    (mul_le_mul_of_nonneg_left hS hrpos.le).trans
      (mul_le_mul_of_nonneg_right hr.2 hSnonneg)
  have hRegularBudget :
      G * ‖originGreenCoeffB K (L / a) Fadj r‖ ≤ G * T :=
    mul_le_mul_of_nonneg_left hT hG
  have hTotal :
      ‖(r : ℂ) * originGreenValue K (L / a) B Fadj r‖ ≤
        B * S + G * T :=
    hTriangle.trans (add_le_add hSingBudget hRegularBudget)
  simpa only [S, T, Fadj, F0, Cr, Cp, Cf, Q, N] using hTotal

end HBL.TypeIIDynamicSelection
