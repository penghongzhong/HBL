import HBL.TypeIIDynamicSelection.ActualHartreeTrueSourceSelectedWholeMatchedWeighted
import HBL.TypeIIDynamicSelection.ActualHartreeMatchedSpectralWeightedQuadraticResidual
import HBL.TypeIIDynamicSelection.ActualHartreeAdjustedKummerSourceContinuity
import Mathlib.Tactic

/-!
# Genuine Hartree source -> unique real speed -> matched weighted quadratic spectral PDE error

This source-faithful theorem removes the last independent weighted-profile
envelope from the spectral correction. The ORIGINAL three-dimensional
nonlocal Hartree source and original Fredholm data uniquely select p;
the whole inhomogeneous Green and its REAL Cramer homogeneous counterpart
produce the actual weighted first matched profile.

For a frozen spectral displacement d, the literal zero-left-jet matched
correction preserves precisely the two original physical Fredholm data
and its weighted differential defect is quadratic in |d|. All fields and
source coefficients are generated by the same real selected p.

Positive time order for d, the moving basis and other full Hartree PDE
terms remain a separate genuine dynamics task, not an added hypothesis.
The source continuity is explicitly required to justify true classical
derivatives and cannot follow from measurable radiation alone.

The nested selected-source proof uses no redundant `dsimp` after refining
the existential witness; this is the repair to the former strict proof's
`tactic made no progress` error. Its spectral defect is spatial/frozen,
not an assertion of positive renormalized-time order.
-/

noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1600000

open Set MeasureTheory Filter
open scoped Topology

namespace HBL.TypeIIDynamicSelection
open HBL.Profile.Kummer HBL.Profile.ActualInner HBL.L2Kernel
open HBL.Modulation HBL.Modulation.Monopole HBL.Modulation.AffineTail

theorem actual_Hartree_true_source_selected_matched_spectral_weighted_quadratic
    {mu theta scale : ℝ} (K : OriginKummerPair mu theta scale)
    (D G B : ℝ) (hD : 0 ≤ D) (hG : 0 ≤ G)
    (hB : 0 < B) (hBOne : B ≤ 1) (hBR : B < scale)
    (hcoeff : ∀ x ∈ Icc 0 scale,
      ‖originFirstCoeff x‖ + ‖originZeroCoeff mu theta‖ ≤ D)
    (hbound : ∀ x ∈ Icc 0 scale,
      ‖K.y x‖ ≤ G ∧ ‖K.dy x‖ ≤ G ∧
        ‖K.x x‖ ≤ G ∧ ‖K.dx x‖ ≤ G)
    (hsmallB : ((D + 1) * G + 1 / 4) * B ^ 2 ≤ 1) :
    ∃ L0 epsilon C Cs Cn Csel Csp : ℝ,
      6 ≤ L0 ∧ 0 < epsilon ∧ epsilon ≤ 1 ∧
      0 < C ∧ 0 < Cs ∧ 0 < Cn ∧ 0 < Csel ∧ 0 < Csp ∧
      ∀ (L c a : ℝ) (hLp : 0 < L),
        L0 ≤ L → L ^ 3 ≤ a → a * |c| ≤ epsilon →
        L / a ≤ B →
      ∀ (Fp Fm : ℝ → ℝ)
        (hp : InWeightedL2 (7 / 4 : ℝ) Fp)
        (hm : InWeightedL2 (7 / 4 : ℝ) Fm),
        Continuous Fp → Continuous Fm →
      ∀ (Bz Az ell : ℝ), 0 ≤ Bz → 0 ≤ Az →
        0 < ell → ell ≤ 1 →
      ∀ (z : ℝ → ℂ), Measurable z →
        (∀ y : ℝ, 0 < y → ‖z y‖ ≤ Bz) →
        (∀ y : ℝ, 1 ≤ y → y * ‖z y‖ ≤ Az) →
        (∀ r ∈ Ioo (0 : ℝ) scale,
          ContinuousAt
            (fun x => -actualHartreeLaplacianScaledKummerSource a ell c z x) r) →
      let F0 : ℝ → ℂ :=
        fun x => -actualHartreeLaplacianScaledKummerSource a ell c z x
      let Q : ℝ :=
        actualHartreePhysicalWeightedSourceConstant Bz Az * ell ^ (1 / 8 : ℝ)
      let N : ℝ :=
        innerWeightedNorm (7 / 4 : ℝ) Fp +
          innerWeightedNorm (7 / 4 : ℝ) Fm
      let Cr : ℝ := 1 + (D + 1) * G * (B ^ 2 + 2)
      let Cp : ℝ := 1 + (D + 1) * G * B ^ 2
      let Cf : ℝ :=
        actualInnerShellValueConstant + actualInnerShellDerivativeConstant
      ∃ p : ℝ × ℝ,
        actualMomentLockedCoupledCompatibility K L c hLp a (L / a) B
          Fp Fm hp hm F0 p.1 p.2 = 0 ∧
        (∀ q : ℝ × ℝ,
          actualMomentLockedCoupledCompatibility K L c hLp a (L / a) B
            Fp Fm hp hm F0 q.1 q.2 = 0 → q = p) ∧
        let Gp := actualMomentLockedInnerPhaseSource L c
        let Gm := actualMomentLockedInnerScaleSource L c
        let hgp := actual_Hartree_moment_locked_inner_phase_source_weighted L c hLp
        let hgm := actual_Hartree_moment_locked_inner_scale_source_weighted L c hLp
        let Fpa := fun r => Fp r + p.2 * Gp r
        let Fma := fun r => Fm r + p.1 * Gm r
        let hpa := innerWeighted_add_smul_mem (7 / 4 : ℝ) Fp Gp hp hgp p.2
        let hma := innerWeighted_add_smul_mem (7 / 4 : ℝ) Fm Gm hm hgm p.1
        let Fadj := fun r => F0 r +
          (-(p.1 : ℂ)) * actualMomentLockedScaledScaleSource a c r +
          (-(p.2 : ℂ)) * actualMomentLockedScaledPhaseSource a c r
        let J := actualMomentLockedCanonicalInnerJet Fpa Fma hpa hma a (L / a)
        let H := (B * ((G * Cr * Cf * Cn + G * Cp + G ^ 2 * Cs * C) * (N + Q)) +
            G * ((((8 / 3 : ℝ) * G * Q) * L ^ (-(3 / 8 : ℝ))) +
              (Csp * G * B * Csel) * (N + Q))) +
          G ^ 2 * ((L / a) * ‖J.2‖ + (L / a + 1) * ‖J.1‖)
        ∀ (d : ℂ) (r : ℝ), r ∈ Icc (L / a) B →
          let v := actualHartreeMatchedSpectralCorrectedValue
            K (L / a) B Fadj J.1 J.2 d
          v (L / a) = J.1 ∧
            HasDerivAt v J.2 (L / a) ∧
            ‖(r : ℂ) *
              (deriv (deriv v) r + frozenFirstCoeff r * deriv v r +
                (frozenZeroCoeff mu theta + d) * v r - Fadj r)‖ ≤
              (2 * G ^ 2 * (B - L / a)) * (‖d‖ ^ 2 * H) := by
  obtain ⟨L0, epsilon, C, Cs, Cn, Csel, Csp,
      hL0, heps, hepsOne, hC, hCs, hCn, hCsel, hCsp, hSelected⟩ :=
    actual_Hartree_true_source_selected_whole_matched_weighted_no_radius_loss
      K D G B hD hG hB hBOne hBR hcoeff hbound hsmallB
  refine ⟨L0, epsilon, C, Cs, Cn, Csel, Csp,
    hL0, heps, hepsOne, hC, hCs, hCn, hCsel, hCsp, ?_⟩
  intro L c a hLp hLarge ha3 hSmall hOrder
    Fp Fm hp hm hcp hcm Bz Az ell hBz hAz hell hellOne
    z hz hSup hStrauss hFcont
  dsimp only
  obtain ⟨p, hCompat, hUnique, hProfile⟩ :=
    hSelected L c a hLp hLarge ha3 hSmall hOrder
      Fp Fm hp hm hcp hcm Bz Az ell hBz hAz hell hellOne
      z hz hSup hStrauss
  refine ⟨p, hCompat, hUnique, ?_⟩
  let F0 : ℝ → ℂ := fun x =>
    -actualHartreeLaplacianScaledKummerSource a ell c z x
  let Fadj : ℝ → ℂ := fun x =>
    F0 x + (-(p.1 : ℂ)) * actualMomentLockedScaledScaleSource a c x +
      (-(p.2 : ℂ)) * actualMomentLockedScaledPhaseSource a c x
  let Q : ℝ :=
    actualHartreePhysicalWeightedSourceConstant Bz Az * ell ^ (1 / 8 : ℝ)
  let N : ℝ := innerWeightedNorm (7 / 4 : ℝ) Fp +
    innerWeightedNorm (7 / 4 : ℝ) Fm
  let Cr : ℝ := 1 + (D + 1) * G * (B ^ 2 + 2)
  let Cp : ℝ := 1 + (D + 1) * G * B ^ 2
  let Cf : ℝ :=
    actualInnerShellValueConstant + actualInnerShellDerivativeConstant
  let Gp := actualMomentLockedInnerPhaseSource L c
  let Gm := actualMomentLockedInnerScaleSource L c
  let hgp := actual_Hartree_moment_locked_inner_phase_source_weighted L c hLp
  let hgm := actual_Hartree_moment_locked_inner_scale_source_weighted L c hLp
  let Fpa := fun x => Fp x + p.2 * Gp x
  let Fma := fun x => Fm x + p.1 * Gm x
  let hpa := innerWeighted_add_smul_mem (7 / 4 : ℝ) Fp Gp hp hgp p.2
  let hma := innerWeighted_add_smul_mem (7 / 4 : ℝ) Fm Gm hm hgm p.1
  let J := actualMomentLockedCanonicalInnerJet Fpa Fma hpa hma a (L / a)
  let H : ℝ :=
    (B * ((G * Cr * Cf * Cn + G * Cp + G ^ 2 * Cs * C) * (N + Q)) +
      G * ((((8 / 3 : ℝ) * G * Q) * L ^ (-(3 / 8 : ℝ))) +
        (Csp * G * B * Csel) * (N + Q))) +
    G ^ 2 * ((L / a) * ‖J.2‖ + (L / a + 1) * ‖J.1‖)
  have ha : 0 < a := (pow_pos hLp 3).trans_le ha3
  have hr0 : 0 < L / a := div_pos hLp ha
  have hWeighted : ∀ r ∈ Icc (L / a) B,
      ‖(r : ℂ) * actualOriginMatchedKummerValue
          K (L / a) B Fadj J.1 J.2 r‖ ≤ H := by
    intro r hr
    simpa only [H, Fadj, F0, J, Q, N, Cr, Cp, Cf,
      Gp, Gm, hgp, hgm, Fpa, Fma, hpa, hma] using hProfile r hr
  have hH : 0 ≤ H := by
    have hpoint := hWeighted (L / a) ⟨le_refl _, hOrder⟩
    exact (norm_nonneg _).trans hpoint
  have hContinuity : ∀ r ∈ Ioo (0 : ℝ) scale,
      ContinuousAt Fadj r := by
    intro r hr
    have hInput : ContinuousAt F0 r := by
      simpa only [F0] using hFcont r hr
    simpa only [Fadj, F0] using
      actual_Hartree_adjusted_Kummer_source_continuousAt
        a c r ha hr.1 F0 hInput p
  intro d r hr
  have hQuad :=
    actual_Hartree_matched_spectral_left_C1_weighted_quadratic_residual
      K (L / a) B G H hr0 hOrder hBR hG hH
      hbound Fadj hContinuity J.1 J.2 d hWeighted r hr
  simpa only [Fadj, F0, J, H, Q, N, Cr, Cp, Cf,
      Gp, Gm, hgp, hgm, Fpa, Fma, hpa, hma] using hQuad

end HBL.TypeIIDynamicSelection
