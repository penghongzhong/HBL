import HBL.TypeIIDynamicSelection.ActualOneOrbitLinearMixedGain
import Mathlib.MeasureTheory.Integral.IntervalIntegral.Basic
import Mathlib.Tactic

/-!
# Genuine physical linear mixed Hartree center charge for one nonzero orbit

This is NOT the abstract Fredholm charge. It is the actual radial
inverse-square Hartree center functional of the REAL-LINEAR part of
the genuine whole-radiation quartic density at terminal time.

The strictly positive scale ell=1/lambda is arbitrary, with NO
preassigned blowup exponent. The source has actual compact annular
support, hence the integral is absolutely convergent. We prove its
O(ell^(5/2)) bound with a global explicit constant.

The full time-dependent three-region original one-layer conclusion
still requires the actual Hartree flow, parameter tangents, Kummer
matching and nonlinear generated-order estimates.
-/

noncomputable section
set_option autoImplicit false
open Set MeasureTheory
open scoped Topology

namespace HBL.TypeIIDynamicSelection
open HBL.Modulation HBL.Modulation.Monopole HBL.Modulation.AffineTail

/-- The actual physical real-linear source 4 W³ Re Z_ell generated by
the exact complex quartic Hartree expansion at terminal radiation g. -/
def actualOneOrbitTerminalLinearMixedDensity (ell r : ℝ) : ℝ :=
  4 * bubble r ^ 3 *
    (rescalePhysicalRadiation ell actualOneOrbitTerminalRadiation r).re

/-- Genuine radial Hartree center projection of the linear mixed density.
No assumed projection estimate, source-order label, or abstract inverse.

The original PDE's radial center normalization is used exactly:
 C(F) = 4*pi*kappa_H integral_(0,+infty) F(r) dr.
The direct interval bound is deliberately slightly nonoptimal:
  |integral F| <= 1024 ell^2 sqrt(ell).
-/
theorem actual_one_orbit_terminal_linear_mixed_Hartree_center_gain
    (ell : ℝ) (hell : 0 < ell) :
    IntegrableOn (actualOneOrbitTerminalLinearMixedDensity ell)
      (Ioi (0 : ℝ)) ∧
    |radialHartreeCenter (actualOneOrbitTerminalLinearMixedDensity ell)| ≤
      4096 * Real.pi * hartreeKappa * ell ^ 2 * Real.sqrt ell := by
  let F : ℝ → ℝ := actualOneOrbitTerminalLinearMixedDensity ell
  let a : ℝ := 1 / (4 * ell)
  let b : ℝ := 4 / ell
  have ha : 0 < a := by
    dsimp [a]
    positivity
  have hab : a ≤ b := by
    dsimp [a, b]
    apply (div_le_div_iff₀ (show 0 < 4 * ell by positivity) hell).2
    nlinarith [hell]
  have hzeroCore (r : ℝ) (hr : r ≤ a) : F r = 0 := by
    dsimp [F, actualOneOrbitTerminalLinearMixedDensity]
    rw [actual_one_orbit_rescaled_terminal_zero_core ell r hell hr]
    simp
  have hzeroFar (r : ℝ) (hr : b ≤ r) : F r = 0 := by
    dsimp [F, actualOneOrbitTerminalLinearMixedDensity]
    rw [actual_one_orbit_rescaled_terminal_zero_far ell r hell hr]
    simp
  have hSupport : Function.support F ⊆ Ioc a b := by
    intro r hr
    constructor
    · by_contra hn
      exact hr (hzeroCore r (le_of_not_gt hn))
    · by_contra hn
      have hbr : b < r := lt_of_not_ge hn
      exact hr (hzeroFar r hbr.le)
  have hSupportPos : Function.support F ⊆ Ioi (0 : ℝ) := by
    intro r hr
    exact ha.trans (hSupport hr).1
  have hZcont : Continuous
      (rescalePhysicalRadiation ell actualOneOrbitTerminalRadiation) := by
    have hg : Continuous actualOneOrbitTerminalRadiation :=
      Complex.continuous_ofReal.comp
        actual_one_orbit_terminal_bump_smooth.continuous
    unfold rescalePhysicalRadiation
    exact continuous_const.mul (hg.comp (continuous_const.mul continuous_id))
  have hFcont : Continuous F := by
    have hW : Continuous bubble := bubble_contDiff_infty.continuous
    change Continuous
      (fun r : ℝ => 4 * bubble r ^ 3 *
        (rescalePhysicalRadiation ell actualOneOrbitTerminalRadiation r).re)
    exact (continuous_const.mul (hW.pow 3)).mul
      (Complex.continuous_re.comp hZcont)
  have hFcompact : HasCompactSupport F := by
    apply HasCompactSupport.of_support_subset_isCompact
      (isCompact_Icc : IsCompact (Icc a b))
    intro r hr
    exact ⟨(hSupport hr).1.le, (hSupport hr).2⟩
  have hIntegrable : IntegrableOn F (Ioi (0 : ℝ)) :=
    (hFcont.integrable_of_hasCompactSupport hFcompact).integrableOn
  have hSetIntegral :
      (∫ r in Ioi (0 : ℝ), F r) = ∫ r, F r := by
    rw [← integral_indicator measurableSet_Ioi,
      indicator_eq_self.2 hSupportPos]
  have hIntervalIntegral :
      (∫ r in Ioi (0 : ℝ), F r) = ∫ r in a..b, F r := by
    calc
      _ = ∫ r, F r := hSetIntegral
      _ = ∫ r in a..b, F r :=
        (intervalIntegral.integral_eq_integral_of_support_subset hSupport).symm
  have hIntervalBound :
      ∀ r ∈ uIoc a b, ‖F r‖ ≤ 256 * ell ^ 3 * Real.sqrt ell := by
    intro r hr
    have hrI : r ∈ Ioc a b := by simpa only [uIoc_of_le hab] using hr
    have hrpos : 0 < r := ha.trans hrI.1
    dsimp [F, actualOneOrbitTerminalLinearMixedDensity]
    simpa only [Real.norm_eq_abs] using
      actual_one_orbit_terminal_mixed_linear_density_seven_halves_gain
        ell r hell hrpos
  have hNormInterval :
      |∫ r in a..b, F r| ≤
        (256 * ell ^ 3 * Real.sqrt ell) * |b - a| := by
    simpa only [Real.norm_eq_abs] using
      (intervalIntegral.norm_integral_le_of_norm_le_const hIntervalBound)
  have hLen : |b - a| ≤ 4 / ell := by
    rw [abs_of_nonneg (sub_nonneg.mpr hab)]
    dsimp [a, b]
    have hapos : 0 < 1 / (4 * ell) := by positivity
    linarith
  have hIntegralGain :
      |∫ r in Ioi (0 : ℝ), F r| ≤
        1024 * ell ^ 2 * Real.sqrt ell := by
    calc
      _ = |∫ r in a..b, F r| := congrArg abs hIntervalIntegral
      _ ≤ (256 * ell ^ 3 * Real.sqrt ell) * |b - a| := hNormInterval
      _ ≤ (256 * ell ^ 3 * Real.sqrt ell) * (4 / ell) :=
        mul_le_mul_of_nonneg_left hLen (by positivity)
      _ = 1024 * ell ^ 2 * Real.sqrt ell := by
        field_simp [hell.ne']
        ring
  have hC : 0 ≤ 4 * Real.pi * hartreeKappa := by
    unfold hartreeKappa
    positivity
  have hCenter :
      |radialHartreeCenter F| ≤
        4096 * Real.pi * hartreeKappa * ell ^ 2 * Real.sqrt ell := by
    unfold radialHartreeCenter
    rw [abs_mul, abs_of_nonneg hC]
    calc
      (4 * Real.pi * hartreeKappa) *
          |∫ r in Ioi (0 : ℝ), F r| ≤
        (4 * Real.pi * hartreeKappa) *
          (1024 * ell ^ 2 * Real.sqrt ell) :=
        mul_le_mul_of_nonneg_left hIntegralGain hC
      _ = _ := by ring
  exact ⟨hIntegrable, hCenter⟩

end HBL.TypeIIDynamicSelection
