import HBL.TypeIIDynamicSelection.ActualMovingRadiationPartition
import HBL.TypeIIDynamicSelection.ActualOneLayerKummerSharedSource
import Mathlib.Tactic

/-!
# Genuine HBL minimum-weight source split: ONE off-terminal Hartree field

No support persistence or independent regional source is assumed.
Split the ACTUAL whole complex Hartree radiation Z with the
time-dependent smooth cutoff from the manuscript. On the moving core
2r <= R(s), the true *complete* Hartree PDE residual splits into

  R(V+Z) - R(V) =
    [R(V+Z_inner) - R(V)] +
    [N(V+Z) - N(V+Z_inner)].

The second term is exactly nonlocal (the differential terms cancel
from the proved moving-core support identity) and includes all
quartic interactions, not just a self-radiation or linear truncation.
The real and imaginary projections of this SAME residual give the
two H+/H- inputs. This provides a source-level three-region bridge
for subsequent Kummer and exterior matching, NOT the final Green
boundary-jet match or all generated positive gains in original 2.12.
-/

noncomputable section
set_option autoImplicit false

open Set MeasureTheory Filter
open scoped Topology

namespace HBL.TypeIIDynamicSelection
open HBL.Modulation.Monopole HBL.Modulation.AffineTail

/-- The core source generated by truncating the ACTUAL physical
regular radiation, rather than an independent imaginary source. -/
def actualOneLayerInnerCoreResidual
    (V : ℝ → ℝ → ℝ) (R : ℝ → ℝ) (Z : ℝ → ℝ → ℂ)
    (b omega s r : ℝ) : ℂ :=
  complexRadialRenormalizedResidual
    (actualOneLayerWithInnerRadiation V R Z) b omega s r -
  complexRadialRenormalizedResidual
    (fun t x => (V t x : ℂ)) b omega s r

/-- True exterior nonlinear Hartree source due only to the REMOVED
radiation of the same physical solution; no independent remote
Riesz density or source amplitude is postulated. -/
def actualOneLayerPhysicalRemoteNonlocalSource
    (V : ℝ → ℝ → ℝ) (R : ℝ → ℝ) (Z : ℝ → ℝ → ℂ)
    (s r : ℝ) : ℂ :=
  complexRadialHartreeNonlinearity
    (actualOneLayerWithWholeRadiation V Z s) r -
  complexRadialHartreeNonlinearity
    (actualOneLayerWithInnerRadiation V R Z s) r

/-- The core physical Hartree PDE source is the exact SUM of its
actual inner-cutoff residual and the true nonlocal exterior
interaction. It is derived from the SAME physical Z at every time. -/
theorem actual_one_layer_common_Hartree_PDE_inner_remote_exact
    (V : ℝ → ℝ → ℝ) (R : ℝ → ℝ) (Z : ℝ → ℝ → ℂ)
    (b omega s r : ℝ)
    (hRc : ContinuousAt R s)
    (hR : ∀ t : ℝ, 0 < R t)
    (hr : 0 < r) (hsep : 2 * r ≤ R s) :
    actualOneLayerCommonPDEResidual V Z b omega s r =
      actualOneLayerInnerCoreResidual V R Z b omega s r +
      actualOneLayerPhysicalRemoteNonlocalSource V R Z s r := by
  have hRemote := actual_one_layer_true_moving_remote_residual_is_nonlinear
    V R Z b omega s r hRc hR hr hsep
  unfold actualOneLayerCommonPDEResidual actualOneLayerInnerCoreResidual
    actualOneLayerPhysicalRemoteNonlocalSource
    actualOneLayerWithWholeRadiation at *
  calc
    complexRadialRenormalizedResidual
        (fun t x => (V t x : ℂ) + Z t x) b omega s r -
      complexRadialRenormalizedResidual
        (fun t x => (V t x : ℂ)) b omega s r =
        (complexRadialRenormalizedResidual
          (actualOneLayerWithInnerRadiation V R Z) b omega s r -
         complexRadialRenormalizedResidual
          (fun t x => (V t x : ℂ)) b omega s r) +
        (complexRadialRenormalizedResidual
          (fun t x => (V t x : ℂ) + Z t x) b omega s r -
         complexRadialRenormalizedResidual
          (actualOneLayerWithInnerRadiation V R Z) b omega s r) := by ring
    _ = _ := by rw [hRemote]

/-- Both actual H+/H- projections retain exactly the SAME full
inner and remote Hartree source, including all nonlinear cross terms. -/
theorem actual_one_layer_common_Hartree_PDE_inner_remote_both_channels
    (V : ℝ → ℝ → ℝ) (R : ℝ → ℝ) (Z : ℝ → ℝ → ℂ)
    (b omega s r : ℝ)
    (hRc : ContinuousAt R s)
    (hR : ∀ t : ℝ, 0 < R t)
    (hr : 0 < r) (hsep : 2 * r ≤ R s) :
    actualOneLayerPlusPDE V Z b omega s r =
      (actualOneLayerInnerCoreResidual V R Z b omega s r +
        actualOneLayerPhysicalRemoteNonlocalSource V R Z s r).re ∧
    actualOneLayerMinusPDE V Z b omega s r =
      (actualOneLayerInnerCoreResidual V R Z b omega s r +
        actualOneLayerPhysicalRemoteNonlocalSource V R Z s r).im := by
  have h := actual_one_layer_common_Hartree_PDE_inner_remote_exact
    V R Z b omega s r hRc hR hr hsep
  exact ⟨congrArg Complex.re h, congrArg Complex.im h⟩

/-- The source magnitude used in the physical H+/H- weighted
Fredholm conditions is controlled by the two ACTUAL components,
rather than two independently assigned model source bounds. -/
theorem actual_one_layer_common_Hartree_PDE_inner_remote_norm_le
    (V : ℝ → ℝ → ℝ) (R : ℝ → ℝ) (Z : ℝ → ℝ → ℂ)
    (b omega s r : ℝ)
    (hRc : ContinuousAt R s)
    (hR : ∀ t : ℝ, 0 < R t)
    (hr : 0 < r) (hsep : 2 * r ≤ R s) :
    ‖actualOneLayerCommonPDEResidual V Z b omega s r‖ ≤
      ‖actualOneLayerInnerCoreResidual V R Z b omega s r‖ +
      ‖actualOneLayerPhysicalRemoteNonlocalSource V R Z s r‖ := by
  rw [actual_one_layer_common_Hartree_PDE_inner_remote_exact
    V R Z b omega s r hRc hR hr hsep]
  exact norm_add_le _ _

end HBL.TypeIIDynamicSelection
