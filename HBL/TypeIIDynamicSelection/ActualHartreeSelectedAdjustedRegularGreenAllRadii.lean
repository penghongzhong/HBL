import HBL.TypeIIDynamicSelection.ActualHartreeTrueSourceSpeedSelection
import HBL.TypeIIDynamicSelection.ActualHartreeAdjustedRegularGreenAllRadii
import Mathlib.Tactic

/-!
# Same original physical Hartree source -> unique real speed -> adjusted full regular Green

Both the original nonlocal inverse-square quartic Hartree source and the
two actual real modulation generators are integrated with the true
unswapped Wronskian. The real velocity is the UNIQUE two-channel Cramer
solution generated by the SAME physical source and inner Fredholm data.

The original regular Green coefficient receives an L^(-3/8) Riesz tail.
The speed-generator coefficient is O(a B |p|_1), while uniqueness and
the original physical compatibility equation give |p|_1 <= Csel/a*(N+Q).
Their scale factors cancel. No independent speed, Green-coefficient
envelope, time exponent or imposed Type-II rate is assumed.

This controls only the adjusted REGULAR Green coefficient at each radius;
the matched homogeneous part, full C¹ joins, time-dependent nonlinear
four-region residual and genuine iterative profile still require proof.
-/

noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

open Set MeasureTheory Filter
open scoped Topology

namespace HBL.TypeIIDynamicSelection
open HBL.Profile.Kummer
open HBL.Modulation HBL.Modulation.Monopole HBL.Modulation.AffineTail
open HBL.Profile.ActualInner HBL.L2Kernel

/-- Physical three-dimensional Hartree forcing selects a UNIQUE real
two-speed and supplies a no-moving-radius-loss bound for the entire
adjusted regular Green coefficient at EVERY intermediate radius. -/
theorem actual_Hartree_true_source_selected_adjusted_regular_Green_all_radii
    {mu theta scale : ℝ} (K : OriginKummerPair mu theta scale)
    (D G B : ℝ) (hD : 0 ≤ D) (hG : 0 ≤ G)
    (hB : 0 < B) (hBOne : B ≤ 1) (hBR : B < scale)
    (hcoeff : ∀ x ∈ Icc 0 scale,
      ‖originFirstCoeff x‖ + ‖originZeroCoeff mu theta‖ ≤ D)
    (hbound : ∀ x ∈ Icc 0 scale,
      ‖K.y x‖ ≤ G ∧ ‖K.dy x‖ ≤ G ∧
        ‖K.x x‖ ≤ G ∧ ‖K.dx x‖ ≤ G)
    (hsmallB : ((D + 1) * G + 1 / 4) * B ^ 2 ≤ 1) :
    ∃ L0 epsilon Csel Csp : ℝ,
      6 ≤ L0 ∧ 0 < epsilon ∧ epsilon ≤ 1 ∧
      0 < Csel ∧ 0 < Csp ∧
      ∀ (L c a : ℝ) (hLp : 0 < L),
        L0 ≤ L → L ^ 3 ≤ a → a * |c| ≤ epsilon →
        L / a ≤ B →
      ∀ (Fp Fm : ℝ → ℝ)
        (hp : InWeightedL2 (7 / 4 : ℝ) Fp)
        (hm : InWeightedL2 (7 / 4 : ℝ) Fm),
        Continuous Fp → Continuous Fm →
      ∀ (Bz Az ell : ℝ), 0 ≤ Bz → 0 ≤ Az →
        0 < ell → ell ≤ 1 →
      ∀ (z : ℝ → ℂ), Measurable z →
        (∀ y : ℝ, 0 < y → ‖z y‖ ≤ Bz) →
        (∀ y : ℝ, 1 ≤ y → y * ‖z y‖ ≤ Az) →
      let F0 : ℝ → ℂ :=
        fun r => -actualHartreeLaplacianScaledKummerSource a ell c z r
      let Q : ℝ :=
        actualHartreePhysicalWeightedSourceConstant Bz Az *
          ell ^ (1 / 8 : ℝ)
      let N : ℝ :=
        innerWeightedNorm (7 / 4 : ℝ) Fp +
          innerWeightedNorm (7 / 4 : ℝ) Fm
      ∃ p : ℝ × ℝ,
        actualMomentLockedCoupledCompatibility K L c hLp a (L / a) B
          Fp Fm hp hm F0 p.1 p.2 = 0 ∧
        (∀ q : ℝ × ℝ,
          actualMomentLockedCoupledCompatibility K L c hLp a (L / a) B
            Fp Fm hp hm F0 q.1 q.2 = 0 → q = p) ∧
        ∀ r ∈ Icc (L / a) B,
          let Fadj : ℝ → ℂ :=
            fun x => F0 x +
              (-(p.1 : ℂ)) * actualMomentLockedScaledScaleSource a c x +
              (-(p.2 : ℂ)) * actualMomentLockedScaledPhaseSource a c x
          ‖originGreenCoeffB K (L / a) Fadj r‖ ≤
            (((8 / 3 : ℝ) * G * Q) * L ^ (-(3 / 8 : ℝ))) +
              (Csp * G * B * Csel) * (N + Q) := by
  obtain ⟨L0, epsilon, Csel,
    hL0, heps, hepsOne, hCsel, hSelected⟩ :=
    actual_Hartree_true_nonlocal_source_selects_unique_real_speed
      K D G B hD hG hB hBOne hBR hcoeff hbound hsmallB
  obtain ⟨Csp, hCsp, hAdjusted⟩ :=
    actual_Hartree_adjusted_original_regular_Green_all_radii
  refine ⟨L0, epsilon, Csel, Csp,
    hL0, heps, hepsOne, hCsel, hCsp, ?_⟩
  intro L c a hLp hLarge ha3 hSmall hOrder
    Fp Fm hp hm hcp hcm Bz Az ell hBz hAz hell hellOne
    z hz hSup hStrauss
  dsimp only
  let F0 : ℝ → ℂ :=
    fun r => -actualHartreeLaplacianScaledKummerSource a ell c z r
  let Q : ℝ :=
    actualHartreePhysicalWeightedSourceConstant Bz Az * ell ^ (1 / 8 : ℝ)
  let N : ℝ :=
    innerWeightedNorm (7 / 4 : ℝ) Fp +
      innerWeightedNorm (7 / 4 : ℝ) Fm
  obtain ⟨p, hCompat, hUnique, hSpeed⟩ :=
    hSelected L c a hLp hLarge ha3 hSmall hOrder
      Fp Fm hp hm hcp hcm Bz Az ell hBz hAz hell hellOne
      z hz hSup hStrauss
  refine ⟨p, hCompat, hUnique, ?_⟩
  have hLone : 1 ≤ L := by linarith
  have ha : 0 < a := (pow_pos hLp 3).trans_le ha3
  have hLpow : 1 ≤ L ^ 3 := by
    have hProd : 0 ≤ (L - 1) * (L ^ 2 + L + 1) :=
      mul_nonneg (by linarith) (by positivity)
    nlinarith
  have haOne : 1 ≤ a := hLpow.trans ha3
  have hc : |c| ≤ 1 := by
    have hNonneg : 0 ≤ |c| := abs_nonneg c
    have hProduct : 0 ≤ (a - 1) * |c| :=
      mul_nonneg (by linarith) hNonneg
    have hSmallOne : a * |c| ≤ 1 := hSmall.trans hepsOne
    nlinarith
  have hSmallOne : a * |c| ≤ 1 := hSmall.trans hepsOne
  have hCoefPos : 0 ≤ Csp * G * a * B := by positivity
  intro r hr
  let Fsp : ℝ → ℂ :=
    fun x => (-(p.1 : ℂ)) * actualMomentLockedScaledScaleSource a c x +
      (-(p.2 : ℂ)) * actualMomentLockedScaledPhaseSource a c x
  let Fadj : ℝ → ℂ := fun x => F0 x + Fsp x
  have hRaw :
      ‖originGreenCoeffB K (L / a) Fadj r‖ ≤
        (((8 / 3 : ℝ) * G * Q) * L ^ (-(3 / 8 : ℝ))) +
          (Csp * G * a * B) * (|p.1| + |p.2|) := by
    simpa only [Fadj, F0, Fsp, Q] using
      (hAdjusted K D G L B a Bz Az ell c
        hD hG hLone ha hOrder hBOne hBR
        hSmallOne hc hcoeff hbound
        hBz hAz hell hellOne z hz hSup hStrauss p r hr)
  have hSpeedApplied :
      (Csp * G * a * B) * (|p.1| + |p.2|) ≤
      (Csp * G * a * B) * ((Csel / a) * (N + Q)) :=
    mul_le_mul_of_nonneg_left hSpeed hCoefPos
  have hCancel :
      (Csp * G * a * B) * ((Csel / a) * (N + Q)) =
        (Csp * G * B * Csel) * (N + Q) := by
    field_simp [ha.ne']
  have hOutput :
      ‖originGreenCoeffB K (L / a) Fadj r‖ ≤
        (((8 / 3 : ℝ) * G * Q) * L ^ (-(3 / 8 : ℝ))) +
          (Csp * G * B * Csel) * (N + Q) := by
    calc
      _ ≤ (((8 / 3 : ℝ) * G * Q) * L ^ (-(3 / 8 : ℝ))) +
            (Csp * G * a * B) * (|p.1| + |p.2|) := hRaw
      _ ≤ (((8 / 3 : ℝ) * G * Q) * L ^ (-(3 / 8 : ℝ))) +
            (Csp * G * a * B) * ((Csel / a) * (N + Q)) :=
        add_le_add_right hSpeedApplied _
      _ = (((8 / 3 : ℝ) * G * Q) * L ^ (-(3 / 8 : ℝ))) +
            (Csp * G * B * Csel) * (N + Q) := by rw [hCancel]
  simpa only [Fadj, Fsp, F0, Q, N, add_assoc] using hOutput

end HBL.TypeIIDynamicSelection
