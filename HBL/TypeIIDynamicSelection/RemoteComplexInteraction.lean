import HBL.TypeIIDynamicSelection.RemoteDensityInteraction
import HBL.MonopoleComplexResidual

/-!
# The TRUE complex-amplitude Hartree remote density interaction

This is the physical complex radiation version of the radial cross-region
identity. Let V be the real radial inner profile and Z be complex radial
radiation supported outside R. On 2r<=R the *actual*
N(V+Z)-N(V) is precisely the exterior Riesz potential of
||V+Z||^4-||V||^4, multiplied by V(r)^3.

No fictitious local cubic term is appended to the PDE. The remote field
does not need to be small pointwise, but the actual two radial integral
rows and the exterior density L1 mass must be integrable.

This is a real theorem about the physical Hartree nonlinear source,
not a statement of construction of an exact PDE trajectory.
-/

noncomputable section
set_option autoImplicit false
open Set MeasureTheory
open scoped Topology

namespace HBL.TypeIIDynamicSelection
open HBL.Modulation.Monopole HBL.Modulation.AffineTail

/-- Exact real quartic-density difference generated by a complex remote
field. Every quartic interaction is retained without polynomial truncation. -/
def remoteComplexQuarticDifference (V : ℝ → ℝ) (Z : ℝ → ℂ)
    (rho : ℝ) : ℝ :=
  ‖(V rho : ℂ) + Z rho‖ ^ 4 - ‖(V rho : ℂ)‖ ^ 4

theorem remoteComplexQuarticDifference_measurable
    (V : ℝ → ℝ) (Z : ℝ → ℂ)
    (hV : Measurable V) (hZ : Measurable Z) :
    Measurable (remoteComplexQuarticDifference V Z) := by
  unfold remoteComplexQuarticDifference
  fun_prop

theorem remoteComplexQuarticDifference_vanishes_in_core
    (V : ℝ → ℝ) (Z : ℝ → ℂ) {R : ℝ}
    (hZ : ∀ rho, rho ≤ R → Z rho = 0) :
    ∀ rho, rho ≤ R → remoteComplexQuarticDifference V Z rho = 0 := by
  intro rho hrho
  simp [remoteComplexQuarticDifference, hZ rho hrho]

/-- Actual nonlocal complex Hartree nonlinearity: a field with complex
exterior radiation changes the inner source *only* via the true exterior
quartic-density Riesz potential, since Z(r)=0 on the inner observation. -/
theorem actual_complexHartree_remote_quartic_source_exact
    (V : ℝ → ℝ) (Z : ℝ → ℂ) {R r : ℝ}
    (hR : 0 < R) (hr : 0 < r) (hsep : 2 * r ≤ R)
    (hZ : ∀ rho, rho ≤ R → Z rho = 0)
    (hVmeas : Measurable V) (hZmeas : Measurable Z)
    (hF : IntegrableOn (remoteComplexQuarticDifference V Z) (Ioi R))
    (hVrow : IntegrableOn
      (fun rho => rho * hartreeRadialLog r rho * ‖(V rho : ℂ)‖ ^ 4)
      (Ioi (0 : ℝ))) :
    complexRadialHartreeNonlinearity
      (fun rho => (V rho : ℂ) + Z rho) r -
      complexRadialHartreeNonlinearity (fun rho => (V rho : ℂ)) r =
    (radialHartreeExteriorPotential
      (remoteComplexQuarticDifference V Z) R r : ℂ) * (V r : ℂ) ^ 3 := by
  let F := remoteComplexQuarticDifference V Z
  have hFm : Measurable F :=
    remoteComplexQuarticDifference_measurable V Z hVmeas hZmeas
  have hFzero : ∀ rho, rho ≤ R → F rho = 0 :=
    remoteComplexQuarticDifference_vanishes_in_core V Z hZ
  have hFindicator : (Ioi R).indicator F = F := by
    funext rho
    by_cases hh : rho ∈ Ioi R
    · simp [hh]
    · have hle : rho ≤ R := le_of_not_gt hh
      simp [hh, hFzero rho hle]
  have hPotF : radialHartreePotential F r =
      radialHartreeExteriorPotential F R r := by
    calc
      radialHartreePotential F r =
        radialHartreePotential ((Ioi R).indicator F) r := by rw [hFindicator]
      _ = _ := (radialHartreeExteriorPotential_eq_indicator F hR.le r).symm
  have hFrowOuter := (radialHartreeExteriorPotential_quadratic_center
    F hFm hF hR hr hsep).2.1
  have hFrow : IntegrableOn
      (fun rho => rho * hartreeRadialLog r rho * F rho) (Ioi (0 : ℝ)) := by
    have heq : (fun rho => rho * hartreeRadialLog r rho * F rho) =
        (Ioi R).indicator
          (fun rho => rho * hartreeRadialLog r rho * F rho) := by
      funext rho
      by_cases hh : rho ∈ Ioi R
      · simp [hh]
      · have hle : rho ≤ R := le_of_not_gt hh
        simp [hh, hFzero rho hle]
    rw [heq]
    exact (hFrowOuter.integrable_indicator measurableSet_Ioi).integrableOn
  have hDensity : (fun rho => ‖(V rho : ℂ) + Z rho‖ ^ 4) =
      (fun rho => ‖(V rho : ℂ)‖ ^ 4 + F rho) := by
    funext rho
    dsimp [F, remoteComplexQuarticDifference]
    ring
  have hPotentialSum :
      radialHartreePotential (fun rho => ‖(V rho : ℂ) + Z rho‖ ^ 4) r =
      radialHartreePotential (fun rho => ‖(V rho : ℂ)‖ ^ 4) r +
        radialHartreeExteriorPotential F R r := by
    rw [hDensity]
    calc
      radialHartreePotential (fun rho => ‖(V rho : ℂ)‖ ^ 4 + F rho) r =
          radialHartreePotential (fun rho => ‖(V rho : ℂ)‖ ^ 4) r +
            radialHartreePotential F r := by
        unfold radialHartreePotential
        have heq : (fun rho => rho * hartreeRadialLog r rho *
            (‖(V rho : ℂ)‖ ^ 4 + F rho)) =
          (fun rho => rho * hartreeRadialLog r rho * ‖(V rho : ℂ)‖ ^ 4) +
            (fun rho => rho * hartreeRadialLog r rho * F rho) := by
          funext rho
          simp only [Pi.add_apply]
          ring
        rw [heq]
        simp only [Pi.add_apply]
        rw [integral_add hVrow hFrow]
        ring
      _ = _ := by rw [hPotF]
  have hZr : Z r = 0 := hZ r (by linarith)
  have hNormSq : ‖(V r : ℂ)‖ ^ 2 = V r ^ 2 := by
    simp only [Complex.norm_real, Real.norm_eq_abs, sq_abs]
  unfold complexRadialHartreeNonlinearity
  rw [hZr, add_zero, hPotentialSum, hNormSq]
  push_cast
  ring

/-- The full remote complex Hartree nonlinear contribution is its *actual*
radial center mass times V^3, with the geometric O(r²) correction.
There are no prescribed terminal exponents or artificial local potentials. -/
theorem actual_complexHartree_remote_center_error_le
    (V : ℝ → ℝ) (Z : ℝ → ℂ) {R r : ℝ}
    (hR : 0 < R) (hr : 0 < r) (hsep : 2 * r ≤ R)
    (hZ : ∀ rho, rho ≤ R → Z rho = 0)
    (hVmeas : Measurable V) (hZmeas : Measurable Z)
    (hF : IntegrableOn (remoteComplexQuarticDifference V Z) (Ioi R))
    (hVrow : IntegrableOn
      (fun rho => rho * hartreeRadialLog r rho * ‖(V rho : ℂ)‖ ^ 4)
      (Ioi (0 : ℝ))) :
    ‖complexRadialHartreeNonlinearity (fun rho => (V rho : ℂ) + Z rho) r -
      complexRadialHartreeNonlinearity (fun rho => (V rho : ℂ)) r -
      (radialHartreeExteriorCenter (remoteComplexQuarticDifference V Z) R : ℂ) *
        (V r : ℂ) ^ 3‖ ≤
    (4 * Real.pi * hartreeKappa * r ^ 2 *
      ∫ rho in Ioi R, |remoteComplexQuarticDifference V Z rho| / rho ^ 2) *
      |V r| ^ 3 := by
  let F := remoteComplexQuarticDifference V Z
  have hs := actual_complexHartree_remote_quartic_source_exact
    V Z hR hr hsep hZ hVmeas hZmeas hF hVrow
  have hFm := remoteComplexQuarticDifference_measurable V Z hVmeas hZmeas
  have hpot := (radialHartreeExteriorPotential_quadratic_center
    F hFm hF hR hr hsep).2.2
  rw [hs]
  have heq : (radialHartreeExteriorPotential F R r : ℂ) * (V r : ℂ) ^ 3 -
      (radialHartreeExteriorCenter F R : ℂ) * (V r : ℂ) ^ 3 =
      ((radialHartreeExteriorPotential F R r -
        radialHartreeExteriorCenter F R : ℝ) : ℂ) * (V r : ℂ) ^ 3 := by
    push_cast
    ring
  rw [heq, norm_mul, Complex.norm_real, Real.norm_eq_abs,
    norm_pow, Complex.norm_real, Real.norm_eq_abs]
  exact mul_le_mul_of_nonneg_right hpot (by positivity)

end HBL.TypeIIDynamicSelection
