import HBL.RealThresholdCoupling
import HBL.KinematicTailEstimates
import Mathlib.MeasureTheory.Integral.IntegralEqImproper
import Mathlib.Analysis.SpecialFunctions.Pow.Asymptotics

/-!
Terminal reconstruction of the retained, actual two-channel observation.
The centre path is given, not claimed to be generated by the Hartree flow.
All time integrability, terminal normalization and uniqueness are proved
from continuity and polynomial bounds. One time-decay power is lost.
Neither a zero-centre diagonalization nor a generator inverse is assumed.
-/

noncomputable section
open Set MeasureTheory Filter
open scoped Topology ContDiff

namespace HBL.Modulation.TriangularRepair
open HBL.Modulation.AffineTail HBL.Modulation.Monopole HBL.L2Kernel

/-- The two actual tested Hamilton components, in their original order. -/
def retainedThresholdObservation
    (Rz : ℝ) (hRz : 0 ≤ Rz) (zeta : ℝ → ℝ) (hzeta : ContDiff ℝ 2 zeta)
    (g : ℝ → ℝ) (hg : ContDiff ℝ 2 g)
    (Rg : ℝ) (hRg : 0 ≤ Rg) (hgcut : ∀ r : ℝ, Rg ≤ r → g r = 0) :
    (FullRadialEnergyL2 × FullRadialEnergyL2) →L[ℝ] (ℝ × ℝ) :=
  ((phaseThresholdCoupling Rz hRz zeta hzeta).comp
    (ContinuousLinearMap.snd ℝ FullRadialEnergyL2 FullRadialEnergyL2)).prod
  (-((realThresholdCoupling g hg Rg hRg hgcut).comp
    (ContinuousLinearMap.fst ℝ FullRadialEnergyL2 FullRadialEnergyL2)))

/-- Bochner terminal integral, with the sign required by a'=w. -/
def retainedThresholdTerminal (w : ℝ → ℝ × ℝ) (s : ℝ) : ℝ × ℝ :=
  -(∫ t in Ioi s, w t)

private theorem tail_integrable
    {w : ℝ → ℝ × ℝ} {s0 p C D : ℝ}
    (hs0 : 0 < s0) (hp : 1 < p) (hw : Continuous w)
    (hb : ∀ t, s0 ≤ t → ‖w t‖ ≤ C * t ^ (-p) + D * t ^ (-p - 1)) :
    IntegrableOn w (Ioi s0) := by
  have hi := ((integrableOn_Ioi_rpow_of_lt
    (show -p < -1 by linarith) hs0).const_mul C).add
    ((integrableOn_Ioi_rpow_of_lt
      (show -p - 1 < -1 by linarith) hs0).const_mul D)
  apply hi.mono' hw.aestronglyMeasurable.restrict
  filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
  exact hb t ht.le

private theorem tail_bound
    {w : ℝ → ℝ × ℝ} {s0 p C D s : ℝ}
    (hs0 : 0 < s0) (hp : 1 < p) (hw : Continuous w)
    (hb : ∀ t, s0 ≤ t → ‖w t‖ ≤ C * t ^ (-p) + D * t ^ (-p - 1))
    (hs : s0 ≤ s) :
    ‖retainedThresholdTerminal w s‖ ≤
      C / (p - 1) * s ^ (1 - p) + D / p * s ^ (-p) := by
  have hsp : 0 < s := hs0.trans_le hs
  have hi := (tail_integrable hs0 hp hw hb).mono_set (Ioi_subset_Ioi hs)
  have hi1 := (integrableOn_Ioi_rpow_of_lt (show -p < -1 by linarith) hsp).const_mul C
  have hi2 := (integrableOn_Ioi_rpow_of_lt (show -p - 1 < -1 by linarith) hsp).const_mul D
  have hI1 : (∫ t in Ioi s, t ^ (-p)) = s ^ (1 - p) / (p - 1) := by
    have he1 : -1 - (p - 1) = -p := by ring
    have he2 : -(p - 1) = 1 - p := by ring
    simpa only [he1, he2] using
      (HBL.Kinematic.integral_Ioi_rpow_neg_one_sub
        (s₀ := s) (δ := p - 1) hsp (by linarith))
  have hI2 : (∫ t in Ioi s, t ^ (-p - 1)) = s ^ (-p) / p := by
    have he : -1 - p = -p - 1 := by ring
    simpa only [he] using
      (HBL.Kinematic.integral_Ioi_rpow_neg_one_sub
        (s₀ := s) (δ := p) hsp (by linarith))
  unfold retainedThresholdTerminal
  rw [norm_neg]
  calc
    ‖∫ t in Ioi s, w t‖ ≤ ∫ t in Ioi s, ‖w t‖ := norm_integral_le_integral_norm _
    _ ≤ ∫ t in Ioi s, C * t ^ (-p) + D * t ^ (-p - 1) := by
      apply integral_mono_ae hi.norm (hi1.add hi2)
      filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
      exact hb t (hs.trans ht.le)
    _ = _ := by
      rw [integral_add hi1 hi2, integral_const_mul, integral_const_mul, hI1, hI2]
      ring

private theorem tail_eq_fixed
    {w : ℝ → ℝ × ℝ} {s0 s : ℝ}
    (hi : IntegrableOn w (Ioi s0)) (hs : s0 ≤ s) :
    retainedThresholdTerminal w s =
      -(∫ t in Ioi s0, w t) + ∫ t in s0..s, w t := by
  have h := intervalIntegral.integral_interval_add_Ioi hi
    (hi.mono_set (Ioi_subset_Ioi hs))
  unfold retainedThresholdTerminal
  rw [← h]
  abel

private theorem tail_continuousOn
    {w : ℝ → ℝ × ℝ} {s0 : ℝ}
    (hw : Continuous w) (hi : IntegrableOn w (Ioi s0)) :
    ContinuousOn (retainedThresholdTerminal w) (Ici s0) := by
  have hc : Continuous (fun s => -(∫ t in Ioi s0, w t) + ∫ t in s0..s, w t) :=
    continuous_const.add (intervalIntegral.differentiable_integral_of_continuous hw).continuous
  apply hc.continuousOn.congr
  intro s hs
  rw [tail_eq_fixed hi hs]

private theorem tail_hasDerivAt
    {w : ℝ → ℝ × ℝ} {s0 s : ℝ}
    (hw : Continuous w) (hi : IntegrableOn w (Ioi s0)) (hs : s0 < s) :
    HasDerivAt (retainedThresholdTerminal w) (w s) s := by
  have hd := intervalIntegral.integral_hasDerivAt_right
    (hw.intervalIntegrable s0 s)
    hw.aestronglyMeasurable.stronglyMeasurableAtFilter hw.continuousAt
  have hm : HasDerivAt
      (fun x => -(∫ t in Ioi s0, w t) + ∫ t in s0..x, w t) (w s) s := by
    simpa only [zero_add] using (hasDerivAt_const s (-(∫ t in Ioi s0, w t))).add hd
  apply hm.congr_of_eventuallyEq
  filter_upwards [Ioi_mem_nhds hs] with x hx
  exact tail_eq_fixed hi hx.le

private theorem tail_tendsto_zero
    {w : ℝ → ℝ × ℝ} {s0 p C D : ℝ}
    (hs0 : 0 < s0) (hp : 1 < p) (hw : Continuous w)
    (hb : ∀ t, s0 ≤ t → ‖w t‖ ≤ C * t ^ (-p) + D * t ^ (-p - 1)) :
    Tendsto (retainedThresholdTerminal w) atTop (𝓝 0) := by
  have h1 : Tendsto (fun s : ℝ => C / (p - 1) * s ^ (1 - p)) atTop (𝓝 0) := by
    simpa only [neg_sub, mul_zero] using
      (tendsto_rpow_neg_atTop (show 0 < p - 1 by linarith)).const_mul (C / (p - 1))
  have h2 : Tendsto (fun s : ℝ => D / p * s ^ (-p)) atTop (𝓝 0) := by
    simpa only [mul_zero] using
      (tendsto_rpow_neg_atTop (show 0 < p by linarith)).const_mul (D / p)
  apply squeeze_zero_norm' _ (by simpa only [add_zero] using h1.add h2)
  filter_upwards [eventually_ge_atTop s0] with s hs
  exact tail_bound hs0 hp hw hb hs

private theorem tail_unique
    {w y : ℝ → ℝ × ℝ} {s0 : ℝ}
    (hi : IntegrableOn w (Ioi s0))
    (hy : ContinuousOn y (Ici s0))
    (hd : ∀ t, s0 < t → HasDerivAt y (w t) t)
    (ht : Tendsto y atTop (𝓝 0)) :
    ∀ s, s0 ≤ s → y s = retainedThresholdTerminal w s := by
  intro s hs
  have hc : ContinuousWithinAt y (Ici s) s :=
    (hy s hs).mono (Ici_subset_Ici.mpr hs)
  have hFTC := integral_Ioi_of_hasDerivAt_of_tendsto hc
    (fun t ht' => hd t (hs.trans_lt ht'))
    (hi.mono_set (Ioi_subset_Ioi hs)) ht
  unfold retainedThresholdTerminal
  simpa only [zero_sub, neg_neg] using
    congrArg (fun v : ℝ × ℝ => -v) hFTC.symm

private theorem source_bound
    (B : (FullRadialEnergyL2 × FullRadialEnergyL2) →L[ℝ] (ℝ × ℝ))
    {q : ℝ → FullRadialEnergyL2 × FullRadialEnergyL2} {F : ℝ → ℝ × ℝ}
    {p Z G t : ℝ}
    (hq : ‖q t‖ ≤ Z * t ^ (-p)) (hF : ‖F t‖ ≤ G * t ^ (-p - 1)) :
    ‖B (q t) + F t‖ ≤ (‖B‖ * Z) * t ^ (-p) + G * t ^ (-p - 1) := by
  calc
    ‖B (q t) + F t‖ ≤ ‖B (q t)‖ + ‖F t‖ := norm_add_le _ _
    _ ≤ ‖B‖ * ‖q t‖ + ‖F t‖ := add_le_add_right (B.le_opNorm _) _
    _ ≤ ‖B‖ * (Z * t ^ (-p)) + G * t ^ (-p - 1) :=
      add_le_add (mul_le_mul_of_nonneg_left hq (norm_nonneg _)) hF
    _ = _ := by ring

/-- A complete terminal reconstruction for the ACTUAL retained Hamilton
observation. This is the threshold equation for a given centre path;
existence of the physical centre evolution is not part of this theorem. -/
theorem retainedThresholdBackward_certified
    (Rz : ℝ) (hRz : 0 ≤ Rz) (zeta : ℝ → ℝ) (hzeta : ContDiff ℝ 2 zeta)
    (hz0 : zeta 0 = 0) (hzR : zeta Rz = 0) (hdzR : deriv zeta Rz = 0)
    (g : ℝ → ℝ) (hg : ContDiff ℝ 2 g)
    (Rg : ℝ) (hRg : 0 ≤ Rg) (hgcut : ∀ r : ℝ, Rg ≤ r → g r = 0)
    (q : ℝ → FullRadialEnergyL2 × FullRadialEnergyL2) (F : ℝ → ℝ × ℝ)
    (s0 p Z G : ℝ) (hs0 : 0 < s0) (hp : 1 < p)
    (hq : Continuous q) (hF : Continuous F)
    (hqbound : ∀ t, s0 ≤ t → ‖q t‖ ≤ Z * t ^ (-p))
    (hFbound : ∀ t, s0 ≤ t → ‖F t‖ ≤ G * t ^ (-p - 1)) :
    let B := retainedThresholdObservation Rz hRz zeta hzeta g hg Rg hRg hgcut
    let w := fun t => B (q t) + F t
    let a := retainedThresholdTerminal w
    (∀ (f h : ℝ → ℝ) (_hf : ContDiff ℝ 2 f) (_hh : ContDiff ℝ 2 h)
      (hfmem : MemLp (deriv (radialU f)) 2 halfLineMeasure)
      (hhmem : MemLp (deriv (radialU h)) 2 halfLineMeasure),
      B (smoothToRadialDotH1 f hfmem, smoothToRadialDotH1 h hhmem) =
        ((∫ r in (0 : ℝ)..Rz, zeta r * hMinusApply (radialU h) r),
          -(∫ r in (0 : ℝ)..Rg, radialU g r * hPlusApply (radialU f) r))) ∧
    (∀ s, s0 ≤ s → IntegrableOn w (Ioi s)) ∧
    ContinuousOn a (Ici s0) ∧
    (∀ s, s0 < s → HasDerivAt a (w s) s) ∧
    (∀ s, s0 ≤ s → ‖a s‖ ≤
      (‖B‖ * Z) / (p - 1) * s ^ (1 - p) + G / p * s ^ (-p)) ∧
    Tendsto a atTop (𝓝 0) ∧
    (∀ y : ℝ → ℝ × ℝ, ContinuousOn y (Ici s0) →
      (∀ t, s0 < t → HasDerivAt y (w t) t) → Tendsto y atTop (𝓝 0) →
      ∀ s, s0 ≤ s → y s = a s) ∧
    (∀ (q2 : ℝ → FullRadialEnergyL2 × FullRadialEnergyL2) (F2 : ℝ → ℝ × ℝ)
      (D E : ℝ), Continuous q2 → Continuous F2 →
      (∀ t, s0 ≤ t → ‖q t - q2 t‖ ≤ D * t ^ (-p)) →
      (∀ t, s0 ≤ t → ‖F t - F2 t‖ ≤ E * t ^ (-p - 1)) →
      ∀ s, s0 ≤ s →
      ‖a s - retainedThresholdTerminal (fun t => B (q2 t) + F2 t) s‖ ≤
        (‖B‖ * D) / (p - 1) * s ^ (1 - p) + E / p * s ^ (-p)) := by
  dsimp only
  let B := retainedThresholdObservation Rz hRz zeta hzeta g hg Rg hRg hgcut
  let w := fun t => B (q t) + F t
  have hw : Continuous w := (B.continuous.comp hq).add hF
  have hb (t : ℝ) (ht : s0 ≤ t) :
      ‖w t‖ ≤ (‖B‖ * Z) * t ^ (-p) + G * t ^ (-p - 1) :=
    source_bound B (hqbound t ht) (hFbound t ht)
  have hi := tail_integrable hs0 hp hw hb
  refine ⟨?_, (fun s hs => hi.mono_set (Ioi_subset_Ioi hs)),
    tail_continuousOn hw hi, (fun s hs => tail_hasDerivAt hw hi hs),
    (fun s hs => tail_bound hs0 hp hw hb hs), tail_tendsto_zero hs0 hp hw hb,
    (fun y hy hd ht => tail_unique hi hy hd ht), ?_⟩
  · intro f h hf hh hfmem hhmem
    have hm := (phaseThresholdCoupling_certified Rz hRz zeta hzeta hz0 hzR hdzR).1
      h hh hhmem
    have hp' := (realThresholdCoupling_certified g hg Rg hRg hgcut).1 f hf hfmem
    change (phaseThresholdCoupling Rz hRz zeta hzeta (smoothToRadialDotH1 h hhmem),
      -realThresholdCoupling g hg Rg hRg hgcut (smoothToRadialDotH1 f hfmem)) = _
    rw [← hm, ← hp'.2]
  · intro q2 F2 D E hq2 hF2 hqdiff hFdiff s hs
    let w2 := fun t => B (q2 t) + F2 t
    have hw2 : Continuous w2 := (B.continuous.comp hq2).add hF2
    have hbd (t : ℝ) (ht : s0 ≤ t) :
        ‖w t - w2 t‖ ≤ (‖B‖ * D) * t ^ (-p) + E * t ^ (-p - 1) := by
      have hid : w t - w2 t = B (q t - q2 t) + (F t - F2 t) := by
        dsimp [w, w2]
        rw [map_sub]
        abel
      rw [hid]
      exact source_bound B (q := fun t => q t - q2 t)
        (F := fun t => F t - F2 t) (hqdiff t ht) (hFdiff t ht)
    have hid := tail_integrable hs0 hp (hw.sub hw2) hbd
    have hi2 : IntegrableOn w2 (Ioi s0) := by
      convert hi.sub hid using 1
      funext t
      exact (sub_sub_cancel (w t) (w2 t)).symm
    have heq : retainedThresholdTerminal w s - retainedThresholdTerminal w2 s =
        retainedThresholdTerminal (fun t => w t - w2 t) s := by
      unfold retainedThresholdTerminal
      rw [integral_sub (hi.mono_set (Ioi_subset_Ioi hs))
        (hi2.mono_set (Ioi_subset_Ioi hs))]
      abel
    change ‖retainedThresholdTerminal w s - retainedThresholdTerminal w2 s‖ ≤ _
    rw [heq]
    exact tail_bound hs0 hp (hw.sub hw2) hbd hs

end HBL.Modulation.TriangularRepair
